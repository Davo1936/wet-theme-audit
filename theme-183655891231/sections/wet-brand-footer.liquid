<footer class="wet-footer">
  <div class="wet-footer__stage">
    <div class="wet-footer__texture" aria-hidden="true"></div>
    <svg class="wet-footer__sweep" viewBox="0 0 1600 180" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-80 150 C380 -40 820 230 1680 25"></path>
      <path d="M-80 169 C380 -21 820 249 1680 44"></path>
    </svg>

    <div class="wet-shell">
      <div class="wet-footer__panel">
        <section class="wet-footer__visit" aria-labelledby="WetFooterVisitHeading-{{ section.id }}">
          <img src="{{ 'wet-pictorial-mark.png' | asset_url }}" width="752" height="172" loading="lazy" alt="WET pictorial mark">
          <p class="wet-kicker">Your next visit</p>
          <h2 id="WetFooterVisitHeading-{{ section.id }}">Plan your visit.</h2>
          <p class="wet-footer__visit-copy">Come as you are. Respect others. Enjoy your time.</p>
          <a class="wet-button" href="/pages/first-timers">Visitor information <span aria-hidden="true">→</span></a>
        </section>

        <section class="wet-footer__signup" aria-labelledby="WetNewsletterHeading-{{ section.id }}">
          <div class="wet-footer__signup-copy">
            <p class="wet-kicker">WET updates</p>
            <h2 id="WetNewsletterHeading-{{ section.id }}">Stay in the loop.</h2>
            <p>Events, weekly updates and important venue news—always sent discreetly.</p>
          </div>
          <div class="wet-footer__signup-form">
            {% form 'customer', id: 'WetNewsletter', class: 'wet-newsletter' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="wet-newsletter__row">
                <label class="wet-sr-only" for="WetNewsletterEmail-{{ section.id }}">Email address</label>
                <input id="WetNewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="Your email address" required>
                <button type="submit">Sign up <span aria-hidden="true">↗</span></button>
              </div>
              {% if form.posted_successfully? %}<p class="wet-newsletter__status" role="status">Thanks—you are subscribed.</p>{% endif %}
              {% if form.errors %}<div class="wet-newsletter__status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            {% endform %}
            <p class="wet-footer__consent">Marketing consent is separate from future WET Rewards participation. Unsubscribe at any time.</p>
          </div>
        </section>
      </div>

      <div class="wet-footer__bottom">
        <span>© {{ 'now' | date: '%Y' }} WET Spa &amp; Sauna</span>
        <span>Adults 18+ · physical photo ID required</span>
        <span>Card transactions appear as Bowen Hills Gym</span>
        <a class="wet-footer__credit" href="https://martinenterprises.tech" target="_blank" rel="noopener noreferrer">Powered by Martin Tech Enterprises</a>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
.wet-footer{position:relative;border-top:1px solid var(--wet-line);background:#050506;overflow:hidden}
.wet-footer__stage{position:relative;isolation:isolate;padding:clamp(72px,8vw,116px) 0 0;background:radial-gradient(circle at 20% 28%,rgba(215,17,42,.19),transparent 31%),radial-gradient(circle at 78% 80%,rgba(101,13,24,.24),transparent 40%),linear-gradient(120deg,#080304 0,#0a0506 48%,#030304 100%)}
.wet-footer__texture{position:absolute;z-index:-2;inset:0;opacity:.42;background:repeating-linear-gradient(102deg,transparent 0 3px,rgba(215,17,42,.045) 4px,transparent 7px)}
.wet-footer__sweep{position:absolute;z-index:-1;inset:auto 0 34px;width:100%;height:180px;fill:none;stroke:var(--wet-red);stroke-width:6}.wet-footer__sweep path+path{stroke:var(--wet-silver);stroke-width:1.5;opacity:.5}
.wet-footer__panel{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(410px,.72fr);overflow:hidden;border:1px solid rgba(196,199,204,.28);border-radius:14px;background:linear-gradient(130deg,rgba(255,255,255,.035),transparent 46%),rgba(7,7,8,.9);box-shadow:0 34px 90px rgba(0,0,0,.32)}
.wet-footer__visit,.wet-footer__signup{min-width:0;padding:clamp(42px,5vw,72px)}
.wet-footer__visit{display:grid;align-content:start;border-right:1px solid rgba(215,17,42,.45)}
.wet-footer__visit>img{width:clamp(145px,14vw,205px);height:auto;margin:0 0 30px}
.wet-footer__visit h2,.wet-footer__signup h2{margin:16px 0 0;font-family:var(--wet-display);font-weight:900;letter-spacing:-.045em;line-height:.86;text-transform:uppercase}
.wet-footer__visit h2{max-width:8ch;font-size:clamp(52px,5.5vw,82px)}
.wet-footer__visit-copy{max-width:470px;margin:22px 0 30px;color:rgba(246,243,238,.78);font-size:13px;font-weight:700;letter-spacing:.08em;line-height:1.6;text-transform:uppercase}
.wet-footer__visit .wet-button{width:max-content;min-width:270px}.wet-footer__visit .wet-button span{margin-left:18px;font-size:18px}
.wet-footer .wet-footer__panel .wet-footer__signup{display:grid;grid-template-columns:1fr;align-content:center;align-items:initial;gap:34px;padding:clamp(42px,5vw,72px);border-bottom:0}
.wet-footer .wet-footer__panel .wet-footer__signup h2{margin:16px 0 0;font-size:clamp(34px,3vw,44px);line-height:.88}
.wet-footer .wet-footer__panel .wet-footer__signup-copy>p:last-child{max-width:440px;margin:16px 0 0;color:var(--wet-muted);font-size:13px;line-height:1.6}
.wet-footer__signup-form{align-self:center}.wet-footer__signup .wet-newsletter__row{grid-template-columns:minmax(0,1fr) auto}.wet-footer__signup .wet-newsletter input,.wet-footer__signup .wet-newsletter button{min-height:56px}.wet-footer__signup .wet-newsletter button{padding-right:0}.wet-footer__consent{margin:14px 0 0!important;color:#858185!important;font-size:11px!important;line-height:1.55!important}
.wet-footer__bottom{position:relative;z-index:2;display:flex;justify-content:space-between;gap:24px;margin-top:36px;padding-block:22px;border-top:1px solid rgba(196,199,204,.2);color:#858185;font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
@media(max-width:1180px){.wet-footer__panel{grid-template-columns:1fr}.wet-footer__visit{border-right:0;border-bottom:1px solid rgba(215,17,42,.45)}.wet-footer__visit h2{max-width:none}.wet-footer__signup{gap:28px}.wet-footer__bottom{display:grid;grid-template-columns:1fr 1fr}}
@media(max-width:600px){.wet-footer__stage{padding-top:52px}.wet-footer__panel{border-radius:9px}.wet-footer__visit,.wet-footer__signup{padding:34px 25px}.wet-footer__visit>img{width:145px;margin-bottom:24px}.wet-footer__visit h2{font-size:49px}.wet-footer__visit-copy{margin-block:18px 25px;font-size:11px}.wet-footer__visit .wet-button{width:100%;min-width:0}.wet-footer__signup h2{font-size:36px}.wet-footer__signup .wet-newsletter__row{grid-template-columns:minmax(0,1fr) auto}.wet-footer__signup .wet-newsletter button{justify-self:auto;padding-left:12px}.wet-footer__bottom{grid-template-columns:1fr;gap:10px;margin-top:25px;padding-bottom:34px}.wet-footer__sweep{bottom:70px}}
@media(max-width:600px){.wet-footer .wet-footer__panel .wet-footer__signup{padding:34px 25px}.wet-footer .wet-footer__panel .wet-footer__signup h2{font-size:36px}}
{% endstylesheet %}

{% schema %}
{"name":"WET brand footer","settings":[]}
{% endschema %}
