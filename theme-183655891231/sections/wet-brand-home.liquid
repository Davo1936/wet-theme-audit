<div class="wet wet-home">
  <section class="wet-home-hero">
    <video class="wet-home-hero__media" autoplay muted loop playsinline poster="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Front_Entry.png?v=1698542898">
      <source src="https://cdn.shopify.com/videos/c/o/v/77379bd98fc641c293a9e565976107a0.mp4" type="video/mp4">
    </video>
    <span class="wet-home-hero__veil"></span>
    <div class="wet-shell wet-home-hero__content">
      <div data-wet-reveal>
        <p class="wet-kicker">Bowen Hills - Brisbane - Adults 18+</p>
        <h1>Brisbane<br>gets WET.</h1>
      </div>
      <div class="wet-home-hero__aside" data-wet-reveal>
        <p class="wet-lead">An established men's spa, sauna and social venue with the space, atmosphere and freedom to make the night your own.</p>
        <div class="wet-actions"><a class="wet-button" href="/pages/pricing-entry">Plan your visit</a><a class="wet-button wet-button--outline" href="/pages/events">What's on</a></div>
      </div>
    </div>
    <svg class="wet-home-hero__curve" viewBox="0 0 1600 250" preserveAspectRatio="none" aria-hidden="true"><path d="M-80 230 C360 -70 800 350 1680 30"/><path d="M-80 252 C360 -48 800 372 1680 52"/></svg>
  </section>

  <section class="wet-now" aria-label="Visit WET today">
    <div class="wet-shell wet-now__shell">
      <div class="wet-now__item"><span class="wet-now__icon">{% render 'wet-icon', name: 'ticket' %}</span><div><span>Standard entry</span><strong>$30</strong></div></div>
      <div class="wet-now__item"><span class="wet-now__icon">{% render 'wet-icon', name: 'calendar' %}</span><div><span>Open today</span><strong>From 11am</strong></div></div>
      <div class="wet-now__item"><span class="wet-now__icon">{% render 'wet-icon', name: 'locker' %}</span><div><span>Included</span><strong>Locker + towels</strong></div></div>
      <div class="wet-now__item"><span class="wet-now__icon">{% render 'wet-icon', name: 'compass' %}</span><div><span>Entry</span><strong>Walk in</strong><small>No booking required</small></div></div>
    </div>
  </section>

  <section class="wet-section wet-intro">
    <div class="wet-shell wet-intro__grid">
      <div data-wet-reveal><p class="wet-kicker">WET since 2000</p><h2 class="wet-title">More than a venue. A Brisbane institution.</h2></div>
      <div class="wet-intro__detail" data-wet-reveal><p class="wet-lead">Pool, spa, sauna, steam, lounges, private spaces, events and a fully serviced servery - all under one roof.</p><a class="wet-link" href="/pages/gallery">Explore the venue ↗</a></div>
    </div>
  </section>

  <section class="wet-section wet-section--panel wet-home-facilities-section">
    <div class="wet-shell">
      <div class="wet-section__head" data-wet-reveal><div><p class="wet-kicker">Inside WET</p><h2 class="wet-title">Heat. Water. Space.</h2></div><div class="wet-section__aside"><p class="wet-copy">A substantial, fully climate-controlled venue designed for moving between energy and calm at your own pace.</p></div></div>
      <div class="wet-home-facilities">
        <a class="wet-media wet-home-facilities__lead" href="/pages/gallery"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Pool_1.png?v=1698537080" width="1440" height="810" loading="lazy" alt="WET swimming pool"><span class="wet-media__label"><span>Swimming pool</span>{% render 'wet-icon', name: 'arrow' %}</span></a>
        <a class="wet-media" href="/pages/gallery"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Spa_1.png?v=1698541385" width="1440" height="810" loading="lazy" alt="WET heated spa"><span class="wet-media__label"><span>Heated spa</span>{% render 'wet-icon', name: 'arrow' %}</span></a>
        <a class="wet-media" href="/pages/gallery"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Sauna.png?v=1699939590" width="1440" height="810" loading="lazy" alt="WET dry sauna"><span class="wet-media__label"><span>Dry sauna</span>{% render 'wet-icon', name: 'arrow' %}</span></a>
      </div>
    </div>
  </section>

  <section class="wet-section wet-home-programme">
    <div class="wet-shell">
      <div class="wet-section__head" data-wet-reveal><div><p class="wet-kicker">Every week at WET</p><h2 class="wet-title">Three nights. Three energies.</h2></div><div class="wet-section__aside"><p class="wet-copy">No advance ticket is required for WET's regular weekly programme. Standard venue admission applies.</p></div></div>
      <div class="wet-schedule">
        <a href="/pages/events"><span>Every Sunday</span><h3>Jam-Packed Sundays</h3><p>One of the biggest regular days on the WET calendar.</p><b>{% render 'wet-icon', name: 'arrow' %}</b></a>
        <a href="/pages/events"><span>Tuesday - all day</span><h3>Towelless Tuesdays</h3><p>WET's all-day Tuesday tradition, from open through to close.</p><b>{% render 'wet-icon', name: 'arrow' %}</b></a>
        <a href="/pages/events"><span>Friday - from 6pm</span><h3>Naked Fridays</h3><p>One of WET's longest-running and most popular weekly nights.</p><b>{% render 'wet-icon', name: 'arrow' %}</b></a>
      </div>
    </div>
  </section>

  <section class="wet-home-event">
    <div class="wet-home-event__poster"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/IMG-20260721-WA0002.jpg?v=1784669934" width="1024" height="1536" loading="lazy" alt="SPLASH Swimwear Dance Party poster"></div>
    <div class="wet-home-event__content"><p class="wet-kicker">Current ticketed event</p><span>Friday 21 August 2026 - 7pm to midnight</span><h2>SPLASH</h2><p class="wet-lead">Swimwear Dance Party.</p><p class="wet-copy">Techno, trance, DJs, pool, spa and a full dance floor take over the entire venue. WET is closed for normal admission while SPLASH is running.</p><div class="wet-actions"><a class="wet-button" href="https://www.eventbrite.com.au/e/splash-swimwear-dance-party-tickets-1994492753516" target="_blank" rel="noopener">Buy Eventbrite tickets</a><a class="wet-button wet-button--outline" href="/pages/events">Event details</a></div></div>
  </section>

  <section class="wet-section wet-section--burgundy wet-home-servery">
    <div class="wet-shell wet-food-feature">
      <div data-wet-reveal><p class="wet-kicker">The WET servery</p><h2 class="wet-title wet-title--small">Stay longer. Refuel upstairs.</h2><p class="wet-lead">Hot food, snacks, coffee, milkshakes and cold drinks are available alongside canned beer and RTDs from the licensed bar.</p><a class="wet-button" href="/pages/food-drink">Explore food &amp; drink</a></div>
      <div class="wet-food-feature__stack"><div><span>Hot food</span><strong>Made for a late night</strong></div><div><span>Coffee &amp; shakes</span><strong>Reset and recharge</strong></div><div><span>Cold drinks</span><strong>Served upstairs</strong></div><div><span>Licensed bar</span><strong>Canned beer &amp; RTDs</strong></div></div>
    </div>
  </section>

  <section class="wet-section wet-home-first">
    <div class="wet-shell wet-first-feature">
      <div class="wet-media"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Wet_Area_Overview_1.png?v=1698543051" width="1440" height="810" loading="lazy" alt="Overview of WET facilities"><span class="wet-media__label"><span>First visit</span><span>Know before you go</span></span></div>
      <div data-wet-reveal><p class="wet-kicker">First time at WET?</p><h2 class="wet-title wet-title--small">Walk in knowing what to expect.</h2><ol><li><span class="wet-step-icon">{% render 'wet-icon', name: 'id' %}</span><div><strong>Bring current physical photo ID</strong><p>WET is strictly 18+ and uses Scan ID.</p></div></li><li><span class="wet-step-icon">{% render 'wet-icon', name: 'reception' %}</span><div><strong>Pay at reception</strong><p>No booking is needed for normal admission.</p></div></li><li><span class="wet-step-icon">{% render 'wet-icon', name: 'locker' %}</span><div><strong>Locker and towels are provided</strong><p>Store your phone, clothing and valuables securely.</p></div></li></ol><a class="wet-link" href="/pages/first-timers">Read the first visit guide ↗</a></div>
    </div>
  </section>

  <section class="wet-section wet-home-location"><span class="wet-curve wet-curve--silver" aria-hidden="true"></span><div class="wet-shell"><div class="wet-home-location__panel" data-wet-reveal><div><p class="wet-kicker">22 Jeays Street - Bowen Hills</p><h2 class="wet-title">Your night starts here.</h2></div><div class="wet-home-location__aside"><p class="wet-copy">Open seven days, minutes from Brisbane's CBD and a short walk from Bowen Hills station.</p><div class="wet-actions"><a class="wet-button" href="/pages/contact">Directions &amp; contact</a></div></div></div></div></section>
</div>

{% stylesheet %}
.wet-home-hero{position:relative;min-height:920px;display:grid;align-items:end;overflow:hidden;background:var(--wet-black)}
.wet-home-hero__media,.wet-home-hero__veil{position:absolute;inset:0;width:100%;height:100%}
.wet-home-hero__media{object-fit:cover;filter:saturate(.78) contrast(1.1)}
.wet-home-hero__veil{background:linear-gradient(90deg,rgba(3,3,4,.9),rgba(3,3,4,.27) 64%),linear-gradient(180deg,rgba(3,3,4,.2),rgba(3,3,4,.92))}
.wet-home-hero__content{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.55fr);gap:70px;align-items:end;padding-block:230px 100px}
.wet-home-hero h1{max-width:9ch;margin-top:32px;font-family:var(--wet-display);font-size:clamp(100px,15.5vw,236px);font-weight:900;letter-spacing:-.06em;line-height:.72;text-transform:uppercase}
.wet-home-hero__aside{max-width:520px;justify-self:end}
.wet-home-hero__aside .wet-actions{margin-top:34px}
.wet-home-hero__curve{position:absolute;z-index:3;left:0;bottom:-40px;width:100%;height:210px;fill:none;stroke:var(--wet-red);stroke-width:12}
.wet-home-hero__curve path+path{stroke:var(--wet-silver);stroke-width:3;opacity:.75}
.wet-now{position:relative;z-index:4;padding:0 0 clamp(34px,4vw,50px);background:var(--wet-black)}.wet-now__shell{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:-30px;border:1px solid rgba(196,199,204,.28);border-radius:14px;background:linear-gradient(135deg,rgba(255,255,255,.035),transparent 46%),rgba(8,9,10,.98);box-shadow:0 24px 70px rgba(0,0,0,.42);overflow:hidden}.wet-now__item{min-width:0;display:grid;grid-template-columns:52px minmax(0,1fr);gap:16px;align-items:center;padding:27px 24px;border-right:1px solid var(--wet-line)}.wet-now__item:last-child{border-right:0}.wet-now__item>div{min-width:0;display:grid;gap:6px}.wet-now__icon{display:grid;width:48px;height:48px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);color:var(--wet-red);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}.wet-now__icon .wet-icon{width:28px;height:28px}.wet-now__item span:not(.wet-now__icon),.wet-now__item small{color:var(--wet-muted);font-size:9px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.wet-now__item strong{font-family:var(--wet-display);font-size:clamp(24px,2.1vw,34px);font-weight:900;letter-spacing:-.015em;line-height:.95;text-transform:uppercase}.wet-now__item small{font-size:8px}
.wet-intro__grid{display:grid;grid-template-columns:minmax(340px,.78fr) minmax(400px,1.02fr);gap:clamp(58px,8vw,128px);align-items:end}
.wet-intro__grid .wet-title{max-width:12ch;margin-top:22px;font-size:clamp(46px,4.8vw,72px)}.wet-intro__detail{padding-bottom:5px}.wet-intro__detail .wet-lead{max-width:760px}.wet-intro__detail .wet-link{margin-top:30px}
.wet-home-facilities{display:grid;grid-template-columns:1.3fr .7fr;grid-template-rows:340px 340px;gap:16px}.wet-home-facilities__lead{grid-row:1/3}
.wet-home-facilities .wet-media__label .wet-icon{width:22px;height:22px;color:var(--wet-red)}
.wet-schedule{padding:0 clamp(22px,3vw,40px);border:1px solid rgba(196,199,204,.26);border-radius:14px;background:#09090a}
.wet-schedule a{display:grid;grid-template-columns:170px minmax(260px,1fr) minmax(240px,.75fr) 40px;gap:30px;align-items:center;min-height:150px;border-bottom:1px solid var(--wet-line);transition:padding .25s ease,background .25s ease}.wet-schedule a:last-child{border-bottom:0}
.wet-schedule a:hover{padding-inline:22px;background:var(--wet-charcoal)}
.wet-schedule span{color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.wet-schedule h3{font-family:var(--wet-display);font-size:clamp(38px,4vw,66px);font-weight:900;letter-spacing:-.035em;line-height:.88;text-transform:uppercase}.wet-schedule p{color:var(--wet-muted);font-size:14px;line-height:1.55}.wet-schedule b{justify-self:end;color:var(--wet-red)}.wet-schedule b .wet-icon{width:24px;height:24px}
.wet-home-event{width:min(var(--wet-max),calc(100% - var(--wet-gutter)*2));display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);margin:clamp(72px,8vw,118px) auto;overflow:hidden;border:1px solid rgba(196,199,204,.28);border-radius:14px;background:var(--wet-red)}.wet-home-event__poster{min-height:780px;background:#09090a}.wet-home-event__poster img{width:100%;height:100%;object-fit:cover;object-position:center}.wet-home-event__content{min-width:0;display:grid;align-content:center;gap:24px;padding:clamp(60px,8vw,120px)}.wet-home-event__content>span{font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.wet-home-event__content h2{max-width:100%;font-family:var(--wet-display);font-size:clamp(88px,10vw,156px);font-weight:900;letter-spacing:-.06em;line-height:.72;text-transform:uppercase}.wet-home-event__content .wet-copy{max-width:650px;color:rgba(255,255,255,.82)}.wet-home-event__content .wet-kicker{color:#fff}.wet-home-event__content .wet-kicker:before{background:#fff}.wet-home-event__content .wet-button{background:var(--wet-black);border-color:var(--wet-black)}
.wet-food-feature{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.7fr);gap:clamp(55px,10vw,150px);align-items:center}.wet-food-feature .wet-lead{margin:32px 0}.wet-food-feature__stack{border-top:1px solid rgba(255,255,255,.25)}.wet-food-feature__stack div{display:grid;gap:8px;padding:24px 0;border-bottom:1px solid rgba(255,255,255,.25)}.wet-food-feature__stack span{font-size:10px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.wet-food-feature__stack strong{font-family:var(--wet-serif);font-size:clamp(27px,3vw,42px);font-weight:400}
.wet-first-feature{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(40px,8vw,120px);align-items:center}.wet-first-feature>.wet-media{min-height:0;aspect-ratio:16/10}.wet-first-feature>.wet-media img{position:absolute;inset:0}.wet-first-feature ol{display:grid;margin:34px 0;padding:0;border-top:1px solid var(--wet-line);list-style:none}.wet-first-feature li{display:grid;grid-template-columns:58px 1fr;gap:18px;align-items:center;padding:21px 0;border-bottom:1px solid var(--wet-line)}.wet-step-icon{display:grid;width:48px;height:48px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);color:var(--wet-red);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}.wet-step-icon .wet-icon{width:29px;height:29px}.wet-first-feature li strong{font-size:16px}.wet-first-feature li p{margin-top:6px;color:var(--wet-muted);font-size:13px;line-height:1.5}.wet-home-location{padding-block:clamp(68px,7vw,104px)}.wet-home-location__panel{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(320px,.72fr);gap:clamp(44px,7vw,108px);align-items:center;padding:clamp(42px,5vw,74px);border:1px solid rgba(196,199,204,.28);border-radius:14px;background:linear-gradient(120deg,rgba(215,17,42,.07),transparent 42%),#09090a}.wet-home-location__panel .wet-title{max-width:9ch;font-size:clamp(48px,4.8vw,74px)}.wet-home-location__aside{max-width:560px}.wet-home-location__aside .wet-actions{margin-top:30px}
.wet-home .wet-section{padding-block:clamp(64px,6.5vw,96px)}.wet-intro{padding-top:clamp(62px,5.5vw,88px)!important;padding-bottom:clamp(56px,5vw,78px)!important;border-bottom:0;background:linear-gradient(180deg,var(--wet-black) 0,#0b0c0e 100%)}.wet-home-facilities-section{padding-top:clamp(44px,4vw,62px)!important;border-bottom:0;background:linear-gradient(180deg,#0b0c0e 0,#0d0e10 100%)}.wet-home-facilities-section .wet-section__head{grid-template-columns:minmax(340px,.78fr) minmax(400px,1.02fr);gap:clamp(58px,8vw,128px);align-items:end;margin-bottom:52px}.wet-home-facilities-section .wet-section__aside{justify-self:start;max-width:620px}.wet-home-programme{border-bottom:0;background:linear-gradient(180deg,#0b0c0e 0,var(--wet-black) 18%)}.wet-home-event{box-shadow:0 34px 90px rgba(0,0,0,.38)}.wet-home-servery{border-bottom:0;background:linear-gradient(135deg,#79101e 0,#5d0c16 56%,#35070d 100%)}.wet-home-first{border-bottom:0;background:linear-gradient(180deg,#18080c 0,var(--wet-black) 22%)}.wet-home-location{padding-bottom:52px!important;border-bottom:0;background:linear-gradient(180deg,var(--wet-black),#0d0e10)}.wet-home-location:after{content:"";position:absolute;z-index:0;left:-10%;bottom:-342px;width:120%;height:420px;border:3px solid rgba(215,17,42,.9);border-radius:50%;pointer-events:none}.wet-home-location .wet-shell{position:relative;z-index:1}.wet-home-location .wet-curve--silver{z-index:1;bottom:-350px}
@media(max-width:1180px){.wet-home-hero{min-height:900px}.wet-home-hero__content{grid-template-columns:1fr;gap:34px;padding-block:205px 92px}.wet-home-hero h1{max-width:8.5ch;font-size:clamp(105px,15vw,166px)}.wet-home-hero__aside{max-width:670px;justify-self:start}.wet-now__shell{grid-template-columns:1fr 1fr}.wet-now__item:nth-child(2){border-right:0}.wet-now__item:nth-child(-n+2){border-bottom:1px solid var(--wet-line)}.wet-intro__grid,.wet-home-facilities-section .wet-section__head{grid-template-columns:1fr;gap:30px}.wet-intro__detail .wet-link{margin-top:24px}.wet-schedule a{grid-template-columns:130px 1fr 28px}.wet-schedule p{display:none}.wet-home-event,.wet-food-feature,.wet-first-feature{grid-template-columns:1fr}.wet-home-event__poster{min-height:720px}.wet-food-feature{gap:56px}.wet-first-feature{gap:48px}.wet-first-feature>.wet-media{min-height:0;aspect-ratio:16/9}.wet-home-location__panel{grid-template-columns:1fr;gap:30px}.wet-home-location__aside{max-width:700px}}
@media(max-width:760px){.wet-home-hero{min-height:820px}.wet-home-hero__content{padding-block:175px 78px}.wet-home-hero h1{max-width:100%;font-size:clamp(56px,16vw,74px);letter-spacing:-.06em}.wet-home-hero__veil{background:linear-gradient(180deg,rgba(3,3,4,.18),rgba(3,3,4,.9) 68%,var(--wet-black))}.wet-now{padding-bottom:34px}.wet-now__shell{margin-top:-20px;border-radius:9px}.wet-now__item{padding:23px 20px}.wet-home-facilities{grid-template-columns:1fr;grid-template-rows:440px 280px 280px}.wet-home-facilities__lead{grid-row:auto}.wet-schedule{border-radius:9px}.wet-schedule a{grid-template-columns:1fr 24px;gap:10px 16px;padding:26px 0}.wet-schedule span,.wet-schedule h3{grid-column:1}.wet-schedule b{grid-column:2;grid-row:1/3;align-self:center}.wet-schedule h3{font-size:43px}.wet-home-event{border-radius:9px}.wet-home-event__poster{min-height:580px}.wet-home-event__content{padding:52px 25px}.wet-home-event__content h2{font-size:clamp(78px,21vw,94px)}.wet-food-feature__stack{margin-top:10px}.wet-first-feature>.wet-media{aspect-ratio:4/3}.wet-first-feature li{grid-template-columns:52px 1fr}.wet-step-icon{width:44px;height:44px}.wet-step-icon .wet-icon{width:26px;height:26px}.wet-home-location{padding-top:58px!important;padding-bottom:42px!important}.wet-home-location__panel{gap:24px;padding:34px 25px;border-radius:9px}.wet-home-location__panel .wet-title{font-size:clamp(42px,13vw,58px)}}
@media(max-width:540px){.wet-now__shell{grid-template-columns:1fr}.wet-now__item,.wet-now__item:nth-child(2){border-right:0;border-bottom:1px solid var(--wet-line)}.wet-now__item:last-child{border-bottom:0}}
{% endstylesheet %}

{% schema %}
{"name":"WET brand home","settings":[]}
{% endschema %}
