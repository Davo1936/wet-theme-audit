{% javascript %}
(() => {
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const loadGooglePlaces = (apiKey) => {
    if (window.google && window.google.maps && window.google.maps.importLibrary) return Promise.resolve();
    if (window.wetGooglePlacesPromise) return window.wetGooglePlacesPromise;
    window.wetGooglePlacesPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&libraries=places&v=weekly&loading=async`;
      script.async = true;
      script.addEventListener('load', resolve, { once: true });
      script.addEventListener('error', reject, { once: true });
      document.head.appendChild(script);
    });
    return window.wetGooglePlacesPromise;
  };
  const makeStars = (rating) => '★★★★★'.slice(0, Math.max(1, Math.min(5, Math.round(rating || 5))));
  const buildReview = (review) => {
    const slide = document.createElement('article');
    const content = document.createElement('div');
    const stars = document.createElement('span');
    const quote = document.createElement('blockquote');
    const footer = document.createElement('footer');
    const author = review.authorAttribution && review.authorAttribution.displayName ? review.authorAttribution.displayName : 'Google user';
    const authorUri = review.authorAttribution && review.authorAttribution.uri ? review.authorAttribution.uri : '';
    const authorElement = authorUri ? document.createElement('a') : document.createElement('strong');
    const source = document.createElement('span');
    slide.className = 'wgr__slide';
    slide.setAttribute('aria-roledescription', 'slide');
    stars.className = 'wgr__stars';
    stars.setAttribute('aria-label', `${review.rating || 5} out of 5 stars`);
    stars.textContent = makeStars(review.rating);
    quote.textContent = `“${review.text || review.originalText || ''}”`;
    authorElement.textContent = author;
    if (authorUri) {
      authorElement.href = authorUri;
      authorElement.target = '_blank';
      authorElement.rel = 'noopener';
    }
    source.textContent = review.relativePublishTimeDescription ? `Google review · ${review.relativePublishTimeDescription}` : 'Google review';
    content.append(stars, quote);
    footer.append(authorElement, source);
    slide.append(content, footer);
    return slide;
  };
  const initialiseCarousel = (root) => {
    const track = root.querySelector('[data-review-track]');
    const dots = root.querySelector('[data-review-dots]');
    const status = root.querySelector('[data-review-status]');
    const previous = root.querySelector('[data-review-previous]');
    const next = root.querySelector('[data-review-next]');
    const interval = Number(root.dataset.interval) || 8000;
    let slides = [];
    let index = 0;
    let timer;
    const render = () => {
      track.style.transform = `translate3d(-${index * 100}%,0,0)`;
      slides.forEach((slide, slideIndex) => {
        slide.setAttribute('aria-hidden', slideIndex === index ? 'false' : 'true');
        slide.setAttribute('aria-label', `${slideIndex + 1} of ${slides.length}`);
      });
      Array.from(dots.children).forEach((dot, dotIndex) => dot.setAttribute('aria-current', dotIndex === index ? 'true' : 'false'));
      status.textContent = `Showing review ${index + 1} of ${slides.length}`;
    };
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!reducedMotion.matches && slides.length > 1) timer = window.setInterval(() => {
        index = (index + 1) % slides.length;
        render();
      }, interval);
    };
    const choose = (newIndex) => {
      index = (newIndex + slides.length) % slides.length;
      render();
      start();
    };
    const refresh = () => {
      slides = Array.from(track.children);
      index = 0;
      dots.replaceChildren();
      slides.forEach((slide, slideIndex) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('aria-label', `Show review ${slideIndex + 1}`);
        dot.addEventListener('click', () => choose(slideIndex));
        dots.appendChild(dot);
      });
      previous.hidden = slides.length < 2;
      next.hidden = slides.length < 2;
      dots.hidden = slides.length < 2;
      render();
      start();
    };
    previous.addEventListener('click', () => choose(index - 1));
    next.addEventListener('click', () => choose(index + 1));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') choose(index - 1);
      if (event.key === 'ArrowRight') choose(index + 1);
    });
    reducedMotion.addEventListener('change', start);
    refresh();
    return { refresh };
  };
  const connectLiveReviews = async (root, carousel) => {
    const apiKey = root.dataset.apiKey;
    if (!apiKey) return;
    await loadGooglePlaces(apiKey);
    const { Place } = await window.google.maps.importLibrary('places');
    let placeId = root.dataset.placeId;
    if (!placeId) {
      const result = await Place.searchByText({ textQuery: 'WET Spa & Sauna, 22 Jeays Street, Bowen Hills QLD 4006, Australia', fields: ['id'], maxResultCount: 1, region: 'au' });
      if (!result.places || !result.places.length) return;
      placeId = result.places[0].id;
    }
    const place = new Place({ id: placeId });
    await place.fetchFields({ fields: ['displayName', 'rating', 'userRatingCount', 'reviews'] });
    const reviews = (place.reviews || []).filter((review) => review.text && Number(review.rating) === 5);
    if (!reviews.length) return;
    root.querySelector('[data-review-track]').replaceChildren(...reviews.map(buildReview));
    const summary = root.querySelector('[data-review-summary]');
    if (place.rating && place.userRatingCount) {
      summary.textContent = `${place.rating.toFixed(1)} average from ${place.userRatingCount} Google reviews`;
      summary.hidden = false;
    }
    root.querySelector('[data-review-kicker]').textContent = 'Live Google reviews';
    root.dataset.reviewSource = 'live';
    carousel.refresh();
  };
  document.querySelectorAll('[data-wet-google-reviews]').forEach((root) => {
    if (root.dataset.carouselReady === 'true') return;
    root.dataset.carouselReady = 'true';
    const carousel = initialiseCarousel(root);
    connectLiveReviews(root, carousel).catch(() => { root.dataset.reviewSource = 'fallback'; });
  });
})();
{% endjavascript %}

