<section class="wgr" id="WetGoogleReviews-{{ section.id }}" data-wet-google-reviews data-api-key="{{ section.settings.google_maps_api_key | escape }}" data-place-id="{{ section.settings.google_place_id | escape }}" data-interval="{{ section.settings.rotation_seconds | times: 1000 }}">
  <div class="wgr__shell">
    <header class="wgr__header">
      <div>
        <p class="wgr__kicker" data-review-kicker>Google reviews</p>
        <h2>Visitors notice the difference.</h2>
        <p class="wgr__summary" data-review-summary hidden></p>
      </div>
      <a class="wgr__link" href="https://www.google.com/maps/search/?api=1&amp;query=WET+Spa+%26+Sauna+Bowen+Hills+QLD" target="_blank" rel="noopener">Read all reviews on Google ↗</a>
    </header>
    <div class="wgr__carousel" role="region" aria-roledescription="carousel" aria-label="Google reviews">
      <div class="wgr__viewport">
        <div class="wgr__track" data-review-track>
          <article class="wgr__slide" aria-roledescription="slide"><div><span class="wgr__stars" aria-label="5 out of 5 stars">★★★★★</span><blockquote>“Excellent spa and sauna. The venue has a pool, jacuzzi, dry sauna and steam room.”</blockquote></div><footer><strong>Chris Lombardo</strong><span>Google review</span></footer></article>
          <article class="wgr__slide" aria-roledescription="slide"><div><span class="wgr__stars" aria-label="5 out of 5 stars">★★★★★</span><blockquote>“Always seemed well cleaned and maintained. Great work to the team at WET.”</blockquote></div><footer><strong>Darryn Skelly</strong><span>Google review</span></footer></article>
          <article class="wgr__slide" aria-roledescription="slide"><div><span class="wgr__stars" aria-label="5 out of 5 stars">★★★★★</span><blockquote>“Great discreet place to go. I found the facility clean and it gave me plenty of choices.”</blockquote></div><footer><strong>John Fargo</strong><span>Google review</span></footer></article>
        </div>
      </div>
      <div class="wgr__controls">
        <div class="wgr__dots" data-review-dots aria-label="Choose a review"></div>
        <div class="wgr__buttons"><button type="button" data-review-previous aria-label="Previous review">←</button><button type="button" data-review-next aria-label="Next review">→</button></div>
      </div>
      <p class="wgr__status" data-review-status aria-live="polite"></p>
    </div>
  </div>
</section>

{% stylesheet %}
