n-bottom:clamp(42px,6vw,82px);color:var(--wgr-red);font-size:18px;letter-spacing:.18em}.wgr__slide blockquote{max-width:24ch;margin:0;font-family:"Cormorant Garamond",Georgia,serif;font-size:clamp(29px,4.1vw,62px);line-height:1.14}.wgr__slide footer{display:grid;gap:8px;padding-top:24px;border-top:1px solid var(--wgr-line);color:var(--wgr-muted);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.wgr__slide footer strong,.wgr__slide footer a{color:#fff;font-size:13px}.wgr__slide footer a{text-decoration:underline;text-decoration-color:var(--wgr-red);text-underline-offset:5px}.wgr__controls{min-height:78px;display:flex;justify-content:space-between;align-items:center;padding:16px clamp(22px,5vw,76px);border-top:1px solid var(--wgr-line)}.wgr__dots{display:flex;gap:9px}.wgr__dots button{width:32px;height:3px;padding:0;border:0;background:var(--wgr-line);font-size:0;transition:background .25s ease,width .25s ease}.wgr__dots button[aria-current="true"]{width:58px;background:var(--wgr-red)}.wgr__buttons{display:flex}.wgr__buttons button{width:48px;height:48px;border:1px solid var(--wgr-line);background:transparent;color:#fff;font-size:22px;transition:background .2s ease,border-color .2s ease}.wgr__buttons button+button{border-left:0}.wgr__buttons button:hover,.wgr__buttons button:focus-visible{border-color:var(--wgr-red);background:var(--wgr-red)}.wgr__status{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}@media(max-width:1180px){.wgr__header{grid-template-columns:1fr;gap:28px;margin-bottom:52px}.wgr__link{justify-self:start}.wgr__slide{grid-template-columns:1fr;gap:42px}.wgr__slide footer{max-width:360px}}@media(max-width:760px){.wgr{--wgr-gutter:22px;padding-block:76px}.wgr__slide{min-height:480px;padding:32px 22px}.wgr__stars{margin-bottom:38px}.wgr__slide blockquote{font-size:clamp(28px,9vw,40px)}.wgr__controls{padding-inline:22px}.wgr__dots button{width:18px}.wgr__dots button[aria-current="true"]{width:34px}}@media(prefers-reduced-motion:reduce){.wgr *{transition:none!important}}
