{% liquid
  assign wet_handle = page.handle
  assign wet_kicker = 'WET Spa & Sauna'
  assign wet_title = page.title
  assign wet_lead = page.title
  assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Front_Entry.png?v=1698542898'
  case wet_handle
    when 'pricing-entry'
      assign wet_kicker = 'Plan your visit'
      assign wet_title = 'Pricing & entry'
      assign wet_lead = 'Clear prices, opening hours and entry requirements before you arrive.'
      assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Front_6.jpg?v=1708698133'
    when 'events'
      assign wet_kicker = 'WET calendar'
      assign wet_title = 'Events'
      assign wet_lead = 'Weekly rituals and one-night takeovers, each with its own pace, crowd and energy.'
      assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Front_4.jpg?v=1708697854'
    when 'first-timers'
      assign wet_kicker = 'First time at WET'
      assign wet_title = 'Walk in easy'
      assign wet_lead = 'Everything you need to know before you arrive, without overcomplicating it.'
      assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Front.jpg?v=1708697473'
    when 'gallery'
      assign wet_kicker = 'Inside WET'
      assign wet_title = 'The venue'
      assign wet_lead = 'A substantial, fully climate-controlled space designed to move between energy and calm.'
      assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Wet_Area_Overview_1.png?v=1698543051'
    when 'faq'
      assign wet_kicker = 'Practical information'
      assign wet_title = 'Questions answered'
      assign wet_lead = 'The details most people want before their first visit.'
    when 'sexual-health-clinic'
      assign wet_kicker = 'Health & safety'
      assign wet_title = 'Look after yourself'
      assign wet_lead = 'Testing, safer-sex supplies and trusted health information made easy to access.'
      assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Front_5.jpg?v=1708697967'
    when 'contact'
      assign wet_kicker = 'Bowen Hills - Brisbane'
      assign wet_title = 'Find WET'
      assign wet_lead = 'Minutes from the CBD and a short walk from Bowen Hills railway station.'
    when 'food-drink'
      assign wet_kicker = 'The WET servery'
      assign wet_title = 'Food & drink'
      assign wet_lead = 'Hot food, snacks, coffee, cold drinks, canned beer and RTDs served inside the licensed venue.'
      assign wet_image = 'https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Upstairs_Lounge_2.png'
  endcase
%}

<div class="wet wet-page wet-page--{{ wet_handle }}">
  <header class="wet-page-hero">
    <img class="wet-page-hero__media" src="{{ wet_image }}" width="1600" height="1200" loading="eager" alt="{{ wet_title | escape }} at WET Spa and Sauna">
    <span class="wet-page-hero__veil"></span>
    <div class="wet-shell wet-page-hero__content"><div data-wet-reveal><p class="wet-kicker">{{ wet_kicker }}</p><h1 class="wet-display">{{ wet_title }}</h1></div><div class="wet-page-hero__aside" data-wet-reveal><p class="wet-lead">{{ wet_lead }}</p></div></div>
  </header>

  {% case wet_handle %}
    {% when 'pricing-entry' %}
      <section class="wet-section"><div class="wet-shell wet-price"><div class="wet-price__primary"><span>Standard admission</span><strong class="wet-price__number">$30</strong><p class="wet-copy">Pay at reception. No booking is required for normal venue entry.</p></div><div class="wet-price__list"><div><span><strong>Concession</strong><small>Current Centrelink Seniors Card or Health Care Card required.</small></span><b>$27</b></div><div><span><strong>Students / under 25</strong><small>Valid student card or physical proof of age required.</small></span><b>$27</b></div><div><span><strong>WET medallion</strong><small>Existing medallions continue to be honoured.</small></span><b>$27</b></div><div><span><strong>10-entry WET Card</strong><small>Ten entries for the price of nine. Available at reception.</small></span><b>$270</b></div></div></div></section>
      <section class="wet-section wet-section--panel"><div class="wet-shell wet-grid-2"><div><p class="wet-kicker">Opening hours</p><h2 class="wet-title wet-title--small">Open late. Seven days.</h2><p class="wet-copy wet-space-top">Public holidays operate 11am-11pm unless a different time is announced. WET is closed on Christmas Day.</p></div><div class="wet-hours"><div><strong>Monday-Thursday</strong><span>11am-11pm</span></div><div><strong>Friday-Saturday</strong><span>11am-2am</span></div><div><strong>Sunday</strong><span>11am-11pm</span></div><div><strong>Public holidays</strong><span>11am-11pm</span></div><div><strong>Christmas Day</strong><span>Closed</span></div></div></div></section>
      <section class="wet-section"><div class="wet-shell"><div class="wet-section__head"><div><p class="wet-kicker">Entry requirements</p><h2 class="wet-title wet-title--small">Bring the essentials.</h2></div><div class="wet-section__aside"><p class="wet-copy">WET is a licensed adults-only venue and uses Scan ID. Photos or digital copies of identification are not accepted.</p></div></div><div class="wet-grid-3"><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'shield' %}</span><h3>Adults only</h3><p>Every visitor must be at least 18 years old.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'id' %}</span><h3>Physical photo ID</h3><p>Bring a current driver licence, proof-of-age card or passport.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'fees' %}</span><h3>Discreet payment</h3><p>Card transactions appear as Bowen Hills Gym on bank statements.</p></article></div></div></section>

    {% when 'events' %}
      <section class="wet-section"><div class="wet-shell"><div class="wet-section__head"><div><p class="wet-kicker">Every week</p><h2 class="wet-title">The regular line-up.</h2></div><div class="wet-section__aside"><p class="wet-copy">No advance ticket is required for regular weekly events. Standard venue admission applies unless otherwise advertised.</p></div></div><div class="wet-schedule"><article><span>Every Sunday</span><h3>Jam-Packed Sundays</h3><p>A high-energy Sunday and one of the biggest regular days on the calendar.</p><b>{% render 'wet-icon', name: 'arrow' %}</b></article><article><span>Tuesday - all day</span><h3>Towelless Tuesdays</h3><p>WET's all-day Tuesday tradition, running from open through to close.</p><b>{% render 'wet-icon', name: 'arrow' %}</b></article><article><span>Friday - from 6pm</span><h3>Naked Fridays</h3><p>One of WET's longest-running regular nights, beginning every Friday at 6pm.</p><b>{% render 'wet-icon', name: 'arrow' %}</b></article></div></div></section>
      <section class="wet-event"><div class="wet-event__poster"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/IMG-20260721-WA0002.jpg?v=1784669934" width="1024" height="1536" loading="lazy" alt="SPLASH Swimwear Dance Party poster"></div><div class="wet-event__body"><p class="wet-kicker">Current ticketed event</p><span>Friday 21 August 2026 - 7pm to midnight</span><h2 class="wet-event__name">SPLASH</h2><p class="wet-lead">Swimwear Dance Party.</p><p>Techno and trance take over WET for one night, with DJs, a full dance floor and access to the pool, spa and sauna.</p><p>WET is closed for normal admission from 7pm until midnight while SPLASH is running.</p><div class="wet-actions"><a class="wet-button" href="https://www.eventbrite.com.au/e/splash-swimwear-dance-party-tickets-1994492753516" target="_blank" rel="noopener">Buy tickets</a><a class="wet-button wet-button--outline" href="/pages/contact">Event enquiry</a></div></div></section>
      <section class="wet-section"><div class="wet-shell"><div class="wet-section__head"><div><p class="wet-kicker">How tickets work</p><h2 class="wet-title wet-title--small">One venue. Two clear entry paths.</h2></div><div class="wet-section__aside"><p class="wet-copy">Regular weekly events remain simple walk-in admission. Special ticketed events use the official checkout shown on this page.</p></div></div><div class="wet-ticket-paths"><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'calendar' %}</span><h3>Regular nights</h3><p>Walk in during normal opening hours. No advance ticket is required unless an event is specifically advertised as ticketed.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'ticket' %}</span><h3>Current event</h3><p>SPLASH is already on sale through Eventbrite. Its existing checkout remains unchanged for this event.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'qr' %}</span><h3>Future tickets</h3><p>Future WET ticketed events will be listed here through our secure online checkout and delivered by email with a QR code.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'fees' %}</span><h3>Clear fees</h3><p>Any booking fee and the final purchase total are shown clearly before payment.</p></article></div><p class="wet-ticket-id">All admission is strictly 18+. Current physical photo ID and Scan ID are required at the venue.</p></div></section>

    {% when 'first-timers' %}
      <section class="wet-section"><div class="wet-shell wet-steps-layout"><div><p class="wet-kicker">How it works</p><h2 class="wet-title wet-title--small">Arrive prepared. Settle in easily.</h2><p class="wet-copy wet-space-top">There is no need to book for normal entry. Arrive during opening hours and the reception team will guide you through check-in.</p></div><ol class="wet-steps"><li><span class="wet-step-icon">{% render 'wet-icon', name: 'id' %}</span><div><h3>Bring physical photo ID</h3><p>WET is strictly 18+ and uses Scan ID. Digital copies and photos are not accepted.</p></div></li><li><span class="wet-step-icon">{% render 'wet-icon', name: 'reception' %}</span><div><h3>Pay at reception</h3><p>Standard entry is $30, with eligible concession rates available.</p></div></li><li><span class="wet-step-icon">{% render 'wet-icon', name: 'locker' %}</span><div><h3>Store your belongings</h3><p>You will receive a secure locker and towels for the duration of your visit.</p></div></li><li><span class="wet-step-icon">{% render 'wet-icon', name: 'compass' %}</span><div><h3>Explore at your pace</h3><p>Move between the pool, heated spa, sauna, steam, showers, lounges and private spaces.</p></div></li></ol></div></section>
      <section class="wet-section wet-section--panel"><div class="wet-shell wet-grid-3"><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'locker' %}</span><h3>Secure locker</h3><p>Your clothes, bag, phone and valuables remain safely stored.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'towel' %}</span><h3>Fresh towels</h3><p>Towels are supplied and can be exchanged when required.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'shield' %}</span><h3>Safer-sex supplies</h3><p>Condoms and lubricant are available throughout the venue.</p></article></div></section>
      <section class="wet-section"><div class="wet-shell wet-feature-split"><div class="wet-media"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Wet_Area_Overview_1.png?v=1698543051" width="1440" height="810" loading="lazy" alt="Overview of WET facilities"><span class="wet-media__label"><span>Inside WET</span><span>Explore freely</span></span></div><div><p class="wet-kicker">Privacy first</p><h2 class="wet-title wet-title--small">Your phone stays upstairs.</h2><p class="wet-copy wet-space-top">Phones, clothes and footwear are not permitted downstairs. Keep them secured in your locker and respect the privacy of everyone in the venue.</p><div class="wet-actions wet-space-top"><a class="wet-button" href="/pages/faq">Read the FAQ</a></div></div></div></section>
      <section class="wet-section wet-section--panel"><div class="wet-shell wet-respect-banner"><div class="wet-respect-banner__icon">{% render 'wet-icon', name: 'shield' %}</div><div><p class="wet-kicker">Our standard</p><h2 class="wet-title wet-title--small">Respect keeps WET welcoming.</h2></div><div><p class="wet-lead">WET is a place to relax, meet people and enjoy yourself in a welcoming environment.</p><p class="wet-copy wet-space-top">Respect other patrons, their personal boundaries and the WET team. Harassment, intimidation, unwanted contact, discrimination or behaviour that compromises another person's comfort or safety will not be accepted. WET may refuse entry or ask a patron to leave when their behaviour negatively affects the safety, comfort or atmosphere of the venue.</p></div></div></section>

    {% when 'gallery' %}
      <section class="wet-stats" aria-label="WET facilities"><div class="wet-stat"><strong>Pool</strong><span>Swimming area</span></div><div class="wet-stat"><strong>Spa</strong><span>Heated relaxation</span></div><div class="wet-stat"><strong>Sauna</strong><span>Dry heat</span></div><div class="wet-stat"><strong>Steam</strong><span>Steam room</span></div></section>
      <section class="wet-section"><div class="wet-shell"><div class="wet-section__head"><div><p class="wet-kicker">Facilities</p><h2 class="wet-title">Built to stay a while.</h2></div><div class="wet-section__aside"><p class="wet-copy">Distinct wet, heat, lounge and private areas give the venue a natural flow. Explore in your own time.</p></div></div><div class="wet-gallery"><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Pool_1.png?v=1698537080" width="1440" height="810" loading="lazy" alt="WET swimming pool"><figcaption>Swimming pool</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Spa_1.png?v=1698541385" width="1440" height="810" loading="lazy" alt="WET heated spa"><figcaption>Heated spa</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Sauna.png?v=1699939590" width="1440" height="810" loading="lazy" alt="WET dry sauna"><figcaption>Dry sauna</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Steam_Room_1.png" width="1440" height="810" loading="lazy" alt="WET steam room"><figcaption>Steam room</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Upstairs_Lounge_2.png" width="1440" height="810" loading="lazy" alt="WET upstairs lounge"><figcaption>Upstairs lounge</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Locker_Room_1.png" width="1440" height="810" loading="lazy" alt="WET locker room"><figcaption>Secure lockers</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Shower_1.png" width="1440" height="810" loading="lazy" alt="WET showers"><figcaption>Showers</figcaption></figure><figure><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Porn_Room_Lounge.png" width="1440" height="810" loading="lazy" alt="WET lounge area"><figcaption>Lounge spaces</figcaption></figure></div></div></section>
      <section class="wet-section wet-section--panel"><div class="wet-shell wet-grid-3"><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'pool' %}</span><h3>Pool &amp; spa</h3><p>Swim, cool down or settle into the heated spa.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'heat' %}</span><h3>Sauna &amp; steam</h3><p>Choose between dry heat and steam with showers nearby.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'lounge' %}</span><h3>Lounges &amp; lockers</h3><p>Secure your belongings, take a break and recharge.</p></article></div></section>

    {% when 'faq' %}
      <section class="wet-section"><div class="wet-shell--narrow wet-faq"><details><summary><span>01</span>Is WET strictly 18+?</summary><div>Yes. Every visitor must be at least 18 and bring current physical photo ID.</div></details><details><summary><span>02</span>What identification can I use?</summary><div>Bring a current physical driver licence, proof-of-age card or passport. Photos and digital copies are not accepted.</div></details><details><summary><span>03</span>Do I need to book?</summary><div>No booking is required for normal venue entry. Some special events use advance tickets.</div></details><details><summary><span>04</span>What is included with entry?</summary><div>Admission includes venue access, a secure locker and towels.</div></details><details><summary><span>05</span>What happens when I arrive?</summary><div>Present your ID, pay admission and receive your locker allocation and towels. Staff can explain the layout.</div></details><details><summary><span>06</span>Can I bring my phone downstairs?</summary><div>No. Phones and recording devices must remain secured in your locker.</div></details><details><summary><span>07</span>Why does WET use Scan ID?</summary><div>Scan ID supports responsible operation of the licensed venue and strengthens patron and staff safety.</div></details><details><summary><span>08</span>What does a card payment show as?</summary><div>Card payments appear as Bowen Hills Gym on bank statements and banking apps.</div></details><details><summary><span>09</span>What facilities are available?</summary><div>Pool, heated spa, dry sauna, steam room, showers, secure lockers, lounges and private areas.</div></details><details><summary><span>10</span>Where is WET?</summary><div>22 Jeays Street, Bowen Hills QLD 4006, close to the CBD and Bowen Hills station.</div></details></div></section>
      <section class="wet-section wet-section--red"><div class="wet-shell wet-section__head wet-no-margin"><div><p class="wet-kicker">Still unsure?</p><h2 class="wet-title wet-title--small">Ask before you arrive.</h2></div><div class="wet-section__aside"><p class="wet-copy wet-copy--white">The team can help with practical questions about entry, facilities or a first visit.</p><div class="wet-actions"><a class="wet-button wet-button--dark" href="/pages/contact">Contact WET</a></div></div></div></section>

    {% when 'sexual-health-clinic' %}
      <section class="wet-section"><div class="wet-shell"><div class="wet-section__head"><div><p class="wet-kicker">RAPID at WET</p><h2 class="wet-title">Free peer-led testing onsite.</h2></div><div class="wet-section__aside"><p class="wet-copy">RAPID provides free, confidential HIV and STI testing at WET. No Medicare card is required and the outreach service is walk-in.</p></div></div><div class="wet-health"><div class="wet-health__time"><span class="wet-card__icon">{% render 'wet-icon', name: 'calendar' %}</span><strong>Tuesday &amp; Friday<br>3pm – 7pm</strong></div><div><h3>WET outreach testing</h3><p>22 Jeays Street, Bowen Hills. Closed on Queensland and Australian public holidays.</p></div><a class="wet-button wet-button--outline" href="https://www.rapid.org.au/outreach-testing" target="_blank" rel="noopener">RAPID details</a></div></div></section>
      <section class="wet-section wet-section--panel"><div class="wet-shell wet-grid-3"><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'shield' %}</span><h3>Condoms &amp; lubricant</h3><p>Available throughout the venue for convenient, discreet access.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'test' %}</span><h3>Free HIV self-tests</h3><p>A RAPID Connect vending machine is accessible near the entry stairs without paid venue entry.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'info' %}</span><h3>Current information</h3><p>Use RAPID and Queensland Health for current testing, vaccination and prevention advice.</p></article></div></section>
      <section class="wet-section"><div class="wet-shell wet-feature-copy"><div><p class="wet-kicker">Mpox vaccination</p><h2 class="wet-title wet-title--small">Free vaccination is available.</h2></div><div><p class="wet-copy">Queensland Health provides current eligibility guidance and a clinic finder for free mpox vaccination.</p><div class="wet-actions wet-space-top"><a class="wet-button" href="https://www.health.qld.gov.au/clinical-practice/guidelines-procedures/diseases-infection/immunisation/immunisation-centres/monkeypox-vaccination-centres" target="_blank" rel="noopener">Find a vaccination centre</a></div></div></div></section>

    {% when 'contact' %}
      <section class="wet-stats" aria-label="WET contact details"><div class="wet-stat"><strong>22 Jeays St</strong><span>Bowen Hills QLD</span></div><div class="wet-stat"><strong>07 3854 1383</strong><span>Telephone</span></div><div class="wet-stat"><strong>7 days</strong><span>Open every week</span></div><div class="wet-stat"><strong>18+</strong><span>Physical ID required</span></div></section>
      <section class="wet-section"><div class="wet-shell wet-contact"><div class="wet-contact__details"><div><p class="wet-kicker">Contact details</p><h2 class="wet-title wet-title--small">Get in touch.</h2></div><div><span>Address</span><p>22 Jeays Street<br>Bowen Hills QLD 4006</p></div><div><span>Phone</span><a href="tel:+61738541383">07 3854 1383</a></div><div><span>Email</span><a href="mailto:wetspa@wet.com.au">wetspa@wet.com.au</a></div><a class="wet-button wet-button--outline" href="https://www.google.com/maps/search/?api=1&amp;query=22+Jeays+Street+Bowen+Hills+QLD+4006" target="_blank" rel="noopener">Open in maps</a></div><div><p class="wet-kicker">Send a message</p><h2 class="wet-title wet-title--small">What do you need to know?</h2>{% form 'contact', class: 'wet-form' %}{% if form.posted_successfully? %}<div class="wet-form__status" role="status">Thanks - your message has been sent.</div>{% endif %}{% if form.errors %}<div class="wet-form__status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div class="wet-form__row"><label>Name<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label><label>Phone<input type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></label></div><label>Email<input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label><label>Message<textarea name="contact[body]" required>{{ form.body }}</textarea></label><button class="wet-button" type="submit">Send message</button>{% endform %}</div></div></section>
      <section class="wet-section wet-section--panel"><div class="wet-shell wet-grid-2"><div><p class="wet-kicker">Opening hours</p><h2 class="wet-title wet-title--small">Open late. Seven days.</h2></div><div class="wet-hours"><div><strong>Monday-Thursday</strong><span>11am-11pm</span></div><div><strong>Friday-Saturday</strong><span>11am-2am</span></div><div><strong>Sunday</strong><span>11am-11pm</span></div><div><strong>Public holidays</strong><span>11am-11pm</span></div><div><strong>Christmas Day</strong><span>Closed</span></div></div></div></section>

    {% when 'food-drink' %}
      <section class="wet-section"><div class="wet-shell"><div class="wet-section__head"><div><p class="wet-kicker">More than a vending machine</p><h2 class="wet-title">A proper venue servery.</h2></div><div class="wet-section__aside"><p class="wet-copy">Take a break upstairs without ending your visit. The servery offers hot food, snacks, coffee, milkshakes and cold drinks, alongside a licensed selection of canned beer and RTDs.</p></div></div><div class="wet-food-grid"><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'food' %}</span><h3>Hot food</h3><p>Easy venue favourites and late-night options served from the upstairs servery.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'coffee' %}</span><h3>Coffee &amp; shakes</h3><p>Hot coffee, iced options and milkshakes when you want to reset.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'drink' %}</span><h3>Cold drinks</h3><p>Soft drinks and water served cold from the upstairs servery.</p></article><article class="wet-card"><span class="wet-card__icon">{% render 'wet-icon', name: 'beer' %}</span><h3>Beer &amp; RTDs</h3><p>Canned beer and ready-to-drink beverages served in the licensed upstairs area.</p></article></div></div></section>
      <section class="wet-section wet-section--burgundy"><div class="wet-shell wet-feature-copy"><div><p class="wet-kicker">How it works</p><h2 class="wet-title wet-title--small">Order now or add it to your locker.</h2></div><div><p class="wet-lead">Servery purchases can be paid immediately or added to a locker tab where available. Ask the team at the counter.</p><p class="wet-copy wet-space-top">Food, drinks and smoking remain in the designated upstairs areas. Alcohol is available during permitted service hours and responsible service conditions apply. Prices and availability can change.</p></div></div></section>
      <section class="wet-section"><div class="wet-shell wet-feature-split"><div class="wet-media"><img src="https://cdn.shopify.com/s/files/1/0813/2024/7583/files/Upstairs_Lounge_2.png" width="1440" height="810" loading="lazy" alt="Upstairs lounge and servery area at WET"><span class="wet-media__label"><span>Upstairs at WET</span><span>Take a break</span></span></div><div><p class="wet-kicker">Stay a little longer</p><h2 class="wet-title wet-title--small">Your visit does not have to stop for a feed.</h2><p class="wet-copy wet-space-top">The servery is part of the WET experience, giving patrons a comfortable place to sit, eat and recharge before heading back downstairs.</p><div class="wet-actions wet-space-top"><a class="wet-button" href="/pages/contact">Ask about the menu</a></div></div></div></section>

    {% else %}
      <section class="wet-section"><div class="wet-shell--narrow wet-copy">{{ page.content }}</div></section>
  {% endcase %}
</div>

{% stylesheet %}
.wet-space-top{margin-top:30px}.wet-no-margin{margin-bottom:0}.wet-copy--white{color:rgba(255,255,255,.86)}.wet-button--dark{background:var(--wet-black);border-color:var(--wet-black)}
.wet-price{display:grid;grid-template-columns:minmax(300px,.42fr) minmax(0,.58fr);gap:0;align-items:stretch;overflow:hidden;border:1px solid rgba(196,199,204,.3);border-radius:14px;background:linear-gradient(130deg,rgba(255,255,255,.035),transparent 48%),#09090a}.wet-price__primary{position:relative;display:grid;align-content:center;gap:18px;min-width:0;padding:clamp(42px,5vw,72px);border-right:1px solid rgba(215,17,42,.46);background:radial-gradient(circle at 20% 70%,rgba(215,17,42,.085),transparent 42%)}.wet-price__primary:before{content:"";position:absolute;top:0;left:clamp(42px,5vw,72px);width:44px;height:3px;background:var(--wet-red)}.wet-price__primary>span{color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.wet-price__number{display:block;max-width:100%;font-size:clamp(105px,11.5vw,168px);font-weight:900;letter-spacing:-.065em;line-height:.78;white-space:nowrap}.wet-price__primary .wet-copy{max-width:430px}.wet-price__list{display:grid;align-content:center;padding:clamp(22px,3.3vw,48px)}.wet-price__list>div{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:25px;align-items:center;padding:22px 0;border-bottom:1px solid var(--wet-line)}.wet-price__list>div:first-child{border-top:1px solid var(--wet-line)}.wet-price__list span{display:grid;gap:6px;min-width:0}.wet-price__list strong{font-size:16px}.wet-price__list small{color:var(--wet-muted);font-size:12px;line-height:1.45}.wet-price__list b{font-family:var(--wet-display);font-size:34px;letter-spacing:-.03em;white-space:nowrap}
.wet-hours{padding:8px clamp(22px,3vw,38px);border:1px solid rgba(196,199,204,.28);border-radius:14px;background:linear-gradient(135deg,rgba(255,255,255,.025),transparent 50%),#09090a}.wet-hours div{display:grid;grid-template-columns:1fr auto;gap:22px;padding:19px 0;border-bottom:1px solid var(--wet-line);font-size:14px}.wet-hours div:last-child{border-bottom:0}.wet-hours span{color:var(--wet-muted)}
.wet-schedule{padding:0 clamp(22px,3vw,40px);border:1px solid rgba(196,199,204,.26);border-radius:14px;background:#09090a}.wet-schedule article{display:grid;grid-template-columns:170px minmax(260px,1fr) minmax(240px,.7fr) 35px;gap:28px;align-items:center;min-height:150px;border-bottom:1px solid var(--wet-line)}.wet-schedule article:last-child{border-bottom:0}.wet-schedule article>span{color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.wet-schedule h3{font-family:var(--wet-display);font-size:clamp(38px,4vw,64px);font-weight:900;letter-spacing:-.035em;line-height:.88;text-transform:uppercase}.wet-schedule p{color:var(--wet-muted);font-size:14px;line-height:1.55}.wet-schedule b{justify-self:end;color:var(--wet-red)}.wet-schedule b .wet-icon{width:24px;height:24px}
.wet-event{display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);background:var(--wet-red)}.wet-event__poster{min-height:820px;background:#09090a}.wet-event__poster img{width:100%;height:100%;object-fit:cover}.wet-event__body{min-width:0;display:grid;align-content:center;gap:23px;padding:clamp(60px,9vw,150px)}.wet-event__body>span{font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.wet-event__name{max-width:100%;font-size:clamp(96px,11.8vw,190px);font-weight:900;letter-spacing:-.06em;line-height:.68}.wet-event__body>p:not(.wet-kicker):not(.wet-lead){max-width:660px;color:rgba(255,255,255,.85);font-size:15px;line-height:1.65}.wet-event .wet-kicker{color:#fff}.wet-event .wet-kicker:before{background:#fff}.wet-event .wet-button{background:var(--wet-black);border-color:var(--wet-black)}
.wet-steps-layout{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(60px,10vw,150px)}.wet-steps{margin:0;padding:8px clamp(22px,3vw,38px);border:1px solid rgba(196,199,204,.27);border-radius:14px;background:#09090a;list-style:none}.wet-steps li{display:grid;grid-template-columns:72px 1fr;gap:22px;align-items:center;padding:28px 0;border-bottom:1px solid var(--wet-line)}.wet-steps li:last-child{border-bottom:0}.wet-steps .wet-step-icon{display:grid;width:58px;height:58px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);color:var(--wet-red);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}.wet-steps .wet-step-icon .wet-icon{width:34px;height:34px}.wet-steps h3{font-family:var(--wet-display);font-size:clamp(30px,3.4vw,50px);font-weight:900;letter-spacing:-.03em;line-height:.92;text-transform:uppercase}.wet-steps p{margin-top:9px;color:var(--wet-muted);font-size:14px;line-height:1.55}
.wet-feature-split{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(48px,8vw,120px);align-items:center}.wet-feature-split>.wet-media{min-height:0;aspect-ratio:16/10}.wet-feature-split>.wet-media img{position:absolute;inset:0}.wet-feature-copy{display:grid;grid-template-columns:minmax(0,1fr) minmax(320px,.72fr);gap:clamp(55px,10vw,150px);align-items:center}
.wet-gallery{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.wet-gallery figure{position:relative;min-height:470px;grid-column:span 5;overflow:hidden;background:var(--wet-panel)}.wet-gallery figure:nth-child(4n+1),.wet-gallery figure:nth-child(4n+4){grid-column:span 7}.wet-gallery img{width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.08);transition:transform .6s ease}.wet-gallery figure:hover img{transform:scale(1.025)}.wet-gallery figcaption{position:absolute;inset:auto 18px 18px;padding:12px 15px;border-left:3px solid var(--wet-red);background:rgba(5,5,6,.86);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
.wet-faq{padding:0 clamp(22px,3.5vw,48px);border:1px solid rgba(196,199,204,.27);border-radius:14px;background:#09090a}.wet-faq details{border-bottom:1px solid var(--wet-line)}.wet-faq details:last-child{border-bottom:0}.wet-faq summary{display:grid;grid-template-columns:1fr 30px;gap:18px;align-items:center;padding:28px 0;color:#fff;list-style:none;cursor:pointer;font-family:var(--wet-display);font-size:clamp(28px,3.4vw,48px);font-weight:900;letter-spacing:-.025em;line-height:.95;text-transform:uppercase}.wet-faq summary::-webkit-details-marker{display:none}.wet-faq summary span{display:none}.wet-faq summary:after{content:"+";justify-self:end;color:var(--wet-red);font-family:var(--wet-body);font-size:28px;font-weight:300;transition:transform .2s ease}.wet-faq details[open] summary:after{transform:rotate(45deg)}.wet-faq details>div{max-width:760px;padding:0 0 30px;color:var(--wet-muted);font-size:15px;line-height:1.7}
.wet-health{display:grid;grid-template-columns:minmax(250px,.65fr) minmax(0,1fr) auto;gap:42px;align-items:center;padding:clamp(30px,4vw,56px);border:1px solid rgba(196,199,204,.29);border-radius:14px;background:linear-gradient(135deg,rgba(215,17,42,.055),transparent 42%),var(--wet-panel)}.wet-health__time{display:flex;gap:22px;align-items:center}.wet-health__time .wet-card__icon{flex:0 0 auto;margin:0}.wet-health__time strong{color:var(--wet-silver);font-family:var(--wet-display);font-size:clamp(27px,2.8vw,42px);line-height:.9;text-transform:uppercase}.wet-health h3{font-family:var(--wet-display);font-size:clamp(36px,4vw,56px);font-weight:900;text-transform:uppercase}.wet-health p{margin-top:8px;color:var(--wet-muted);font-size:14px;line-height:1.55}
.wet-contact{display:grid;grid-template-columns:minmax(0,.72fr) minmax(0,1.28fr);gap:clamp(60px,9vw,140px)}.wet-contact__details{display:grid;align-content:start;gap:34px}.wet-contact__details>div:not(:first-child){padding-top:17px;border-top:1px solid var(--wet-line)}.wet-contact__details span{display:block;margin-bottom:9px;color:var(--wet-silver);font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.wet-contact__details>div:not(:first-child) p,.wet-contact__details>div:not(:first-child)>a{font-family:var(--wet-display);font-size:clamp(25px,2.8vw,39px);font-weight:900;letter-spacing:-.025em;line-height:1.05;text-transform:uppercase}.wet-form{display:grid;gap:20px;margin-top:36px}.wet-form__row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.wet-form label{display:grid;gap:8px;color:var(--wet-muted);font-size:9px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.wet-form input,.wet-form textarea{width:100%;min-height:58px;padding:14px 0;border:0!important;border-bottom:1px solid var(--wet-line)!important;border-radius:0!important;background:transparent!important;color:#fff!important;box-shadow:none!important;font-size:16px;letter-spacing:0;text-transform:none}.wet-form textarea{min-height:160px;resize:vertical}.wet-form input:focus,.wet-form textarea:focus{outline:0;border-bottom-color:var(--wet-red)!important}.wet-form__status{padding:15px;border:1px solid var(--wet-line);color:var(--wet-muted);font-size:13px}
.wet-food-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.wet-food-grid .wet-card{padding:clamp(25px,3vw,42px)}.wet-food-grid .wet-card h3{font-size:clamp(30px,3vw,46px)}
.wet-ticket-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:54px}.wet-ticket-paths .wet-card{padding:clamp(25px,3vw,42px)}.wet-ticket-paths .wet-card h3{font-size:clamp(30px,3vw,46px)}.wet-ticket-id{margin-top:22px;padding:20px 0;border-top:1px solid var(--wet-line);border-bottom:1px solid var(--wet-line);color:var(--wet-muted);font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
.wet-respect-banner{display:grid;grid-template-columns:120px minmax(280px,.8fr) minmax(0,1.2fr);gap:clamp(34px,5vw,74px);align-items:center;padding:clamp(38px,5vw,72px);border:1px solid rgba(196,199,204,.3);border-radius:14px;background:linear-gradient(125deg,rgba(215,17,42,.085),transparent 43%),#09090a}.wet-respect-banner__icon{display:grid;width:104px;height:104px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);color:var(--wet-red);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}.wet-respect-banner__icon .wet-icon{width:62px;height:62px}.wet-respect-banner .wet-title{margin-top:20px}.wet-respect-banner .wet-lead{font-size:clamp(19px,1.8vw,26px)}
@media(max-width:1180px){.wet-price,.wet-steps-layout,.wet-feature-split,.wet-feature-copy,.wet-contact{grid-template-columns:1fr}.wet-price__primary{border-right:0;border-bottom:1px solid rgba(215,17,42,.46)}.wet-price__number{font-size:clamp(100px,20vw,150px)}.wet-schedule article{grid-template-columns:130px 1fr 30px}.wet-schedule p{display:none}.wet-event{grid-template-columns:1fr}.wet-event__poster{min-height:700px}.wet-feature-split{gap:48px}.wet-feature-split>.wet-media{min-height:0;aspect-ratio:16/9}.wet-contact{gap:72px}.wet-health{grid-template-columns:1fr 1fr;align-items:start}.wet-health>a{grid-column:1/-1;width:max-content}.wet-ticket-paths,.wet-food-grid{grid-template-columns:1fr 1fr}.wet-respect-banner{grid-template-columns:100px 1fr}.wet-respect-banner>div:last-child{grid-column:2}}
@media(max-width:760px){.wet-price{border-radius:9px}.wet-price__primary{padding:36px 25px}.wet-price__primary:before{left:25px}.wet-price__number{font-size:104px}.wet-price__list{padding:8px 24px 20px}.wet-price__list>div{grid-template-columns:minmax(0,1fr) auto;gap:14px}.wet-price__list b{font-size:30px}.wet-schedule article{grid-template-columns:1fr 24px;gap:10px 18px;padding:26px 0;min-height:0}.wet-schedule article>span,.wet-schedule h3{grid-column:1}.wet-schedule b{grid-column:2;grid-row:1/3}.wet-schedule h3{font-size:42px}.wet-event__poster{min-height:580px}.wet-event__body{padding:60px 22px}.wet-event__name{font-size:92px}.wet-feature-split>.wet-media{aspect-ratio:4/3}.wet-gallery{display:block}.wet-gallery figure{min-height:350px;margin-bottom:14px}.wet-faq summary{grid-template-columns:1fr 24px;gap:11px;font-size:27px}.wet-faq details>div{padding-left:0}.wet-contact__details>div:not(:first-child) p,.wet-contact__details>div:not(:first-child)>a{font-size:29px}.wet-form__row{grid-template-columns:1fr}.wet-health{grid-template-columns:1fr;padding:28px 22px}.wet-health>a{grid-column:auto;width:100%}.wet-steps li{grid-template-columns:60px 1fr;gap:16px}.wet-steps .wet-step-icon{width:50px;height:50px}.wet-steps .wet-step-icon .wet-icon{width:29px;height:29px}.wet-respect-banner{grid-template-columns:1fr;padding:30px 24px;border-radius:9px}.wet-respect-banner>div:last-child{grid-column:auto}.wet-respect-banner__icon{width:82px;height:82px}.wet-respect-banner__icon .wet-icon{width:48px;height:48px}}
@media(max-width:680px){.wet-ticket-paths{grid-template-columns:1fr;margin-top:36px}.wet-food-grid{grid-template-columns:1fr}}
/* Carry the From the Team panel language through the informational pages. */
.wet-event{width:min(var(--wet-max),calc(100% - var(--wet-gutter)*2));margin:clamp(72px,8vw,118px) auto;overflow:hidden;border:1px solid rgba(196,199,204,.28);border-radius:14px}.wet-event__poster{min-height:760px}.wet-event__body{padding:clamp(58px,8vw,116px)}.wet-event__name{font-size:clamp(86px,10vw,154px);line-height:.72}.wet-gallery figure{border:1px solid rgba(196,199,204,.22);border-radius:12px}.wet-contact__details>div:not(:first-child){border-top-color:rgba(196,199,204,.25)}
@media(max-width:760px){.wet-event{border-radius:9px}.wet-event__body{padding:52px 25px}.wet-event__name{font-size:82px}.wet-gallery figure{border-radius:9px}.wet-faq{border-radius:9px}.wet-hours,.wet-steps,.wet-health{border-radius:9px}}
{% endstylesheet %}

