{% liquid
  assign wet_staff_voices = metaobjects.wet_staff_voice.values
  assign wet_staff_shown = 0
  assign wet_staff_limit = section.settings.max_items | default: 3
%}

{% if section.settings.mode == 'archive' %}
  <section class="wet wet-team-page" aria-labelledby="WetTeamHeading-{{ section.id }}">
    <div class="wet-team-page__hero">
      <div class="wet-shell wet-team-page__hero-grid">
        <div class="wet-team-page__intro" data-wet-reveal>
          <p class="wet-team-page__eyebrow"><span></span>From the WET team</p>
          <h1 id="WetTeamHeading-{{ section.id }}">The people<br>behind WET<span>.</span></h1>
          <p class="wet-team-page__promise">Creating a space where everyone feels welcome.</p>
          <div class="wet-team-page__copy">
            <p>Every day, our team works behind the scenes to make WET a clean, comfortable and respectful place for everyone who visits.</p>
            <p>Whether we’re preparing the venue, welcoming guests or maintaining the facilities, our focus is simple: creating an environment where people can relax and enjoy themselves.</p>
          </div>
        </div>

        <div class="wet-team-page__hero-art" aria-hidden="true" data-wet-reveal>
          <span class="wet-team-page__brush wet-team-page__brush--one"></span>
          <span class="wet-team-page__brush wet-team-page__brush--two"></span>
          <svg class="wet-team-page__people-mark" viewBox="0 0 360 300" role="img">
            <g fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="87" cy="120" r="31"/><circle cx="180" cy="104" r="34"/><circle cx="273" cy="120" r="31"/>
              <path d="M35 226v-42c0-34 22-54 52-54s52 20 52 54v42M221 226v-42c0-34 22-54 52-54s52 20 52 54v42M129 230v-54c0-38 22-62 51-62s51 24 51 62v54"/>
              <path d="M180 48V14M132 59l-18-29M228 59l18-29M93 76 66 57M267 76l27-19"/>
            </g>
          </svg>
          <svg class="wet-team-page__sweep" viewBox="0 0 500 130" preserveAspectRatio="none">
            <path d="M20 105C132 20 270 104 480 28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
            <path d="M36 111C162 42 292 112 467 56" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".55"/>
          </svg>
        </div>
      </div>
    </div>

    <div class="wet-shell">
      <section class="wet-team-beliefs" aria-labelledby="WetBeliefsHeading-{{ section.id }}">
        <div class="wet-team-page__section-heading" data-wet-reveal>
          <h2 id="WetBeliefsHeading-{{ section.id }}">What we believe</h2><span></span>
        </div>

        <div class="wet-team-beliefs__grid">
          <article class="wet-team-belief" data-wet-reveal>
            <div class="wet-team-belief__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M32 53 12 34C4 26 9 12 21 12c6 0 10 4 11 8 2-4 6-8 12-8 12 0 17 14 8 22Z"/></svg>
            </div>
            <h3>Respect comes first</h3>
            <p>A great atmosphere starts with treating others with kindness and consideration.</p>
          </article>

          <article class="wet-team-belief" data-wet-reveal>
            <div class="wet-team-belief__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><circle cx="32" cy="18" r="8"/><circle cx="13" cy="26" r="6"/><circle cx="51" cy="26" r="6"/><path d="M19 52V40c0-9 5-14 13-14s13 5 13 14v12M3 49V39c0-6 4-10 10-10 4 0 7 2 9 5M61 49V39c0-6-4-10-10-10-4 0-7 2-9 5"/></svg>
            </div>
            <h3>Everyone belongs</h3>
            <p>WET welcomes people from all backgrounds. We value diversity, inclusion and mutual respect.</p>
          </article>

          <article class="wet-team-belief" data-wet-reveal>
            <div class="wet-team-belief__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><path d="M32 6C27 18 16 29 16 40a16 16 0 0 0 32 0C48 29 37 18 32 6Z"/><path d="M38 40c0 5-3 8-8 9"/></svg>
            </div>
            <h3>Clean spaces matter</h3>
            <p>We work hard every day to keep the venue clean, safe and enjoyable.</p>
          </article>

          <article class="wet-team-belief" data-wet-reveal>
            <div class="wet-team-belief__icon" aria-hidden="true">
              <svg viewBox="0 0 64 64"><circle cx="32" cy="32" r="23"/><circle cx="24" cy="27" r="2"/><circle cx="40" cy="27" r="2"/><path d="M21 38c3 6 7 9 11 9s8-3 11-9"/></svg>
            </div>
            <h3>Friendly service</h3>
            <p>Our team is here to help make your visit as comfortable as possible.</p>
          </article>
        </div>
      </section>

      <section class="wet-team-respect" aria-labelledby="WetRespectHeading-{{ section.id }}" data-wet-reveal>
        <div class="wet-team-respect__art" aria-hidden="true">
          <svg viewBox="0 0 180 180">
            <circle cx="90" cy="90" r="70" opacity=".28"/>
            <path d="M36 93 68 61c7-7 17-7 24 0l8 8M144 93l-32-32c-7-7-17-7-24 0L66 83c-5 5-5 13 0 18s13 5 18 0l16-16M43 100l33 33c5 5 13 5 18 0l4-4M137 100l-32 33c-5 5-13 5-18 0L65 111M100 85l24 24M89 96l24 24M77 107l23 23"/>
            <path class="wet-team-respect__accent" d="M30 47c18-19 41-29 67-29M22 64c11-17 24-29 40-36M150 129c-18 20-42 31-70 32"/>
          </svg>
        </div>
        <div class="wet-team-respect__content">
          <h2 id="WetRespectHeading-{{ section.id }}">Why respect matters</h2>
          <p>The atmosphere at WET is created by everyone who walks through our doors.</p>
          <p>By respecting personal boundaries, communicating clearly and treating others with courtesy, we help create an environment where everyone can feel comfortable.</p>
          <p>If behaviour affects the comfort or safety of others, our team will step in to help maintain a positive experience for everyone.</p>
        </div>
      </section>

      <section class="wet-team-commitment" aria-labelledby="WetCommitmentHeading-{{ section.id }}">
        <div class="wet-team-commitment__badge" aria-hidden="true" data-wet-reveal>
          <svg viewBox="0 0 90 90"><circle cx="45" cy="45" r="39"/><path d="m45 18 4 9 10 1-8 7 2 10-8-5-9 5 2-10-8-7 11-1Z"/><path d="M25 57h40M25 66h40"/></svg>
        </div>
        <div class="wet-team-commitment__copy" data-wet-reveal>
          <h2 id="WetCommitmentHeading-{{ section.id }}">Our commitment</h2>
          <p>We’re proud of the community that has grown around WET. Every visit, every interaction and every conversation contributes to making this a welcoming place for everyone.</p>
          <strong>Thank you for being part of it.</strong>
        </div>
        <ul class="wet-team-commitment__list" data-wet-reveal>
          <li>Be kind</li>
          <li>Respect boundaries</li>
          <li>Look out for each other</li>
          <li>Help keep WET a great place</li>
        </ul>
      </section>
    </div>

    {% if wet_staff_voices != blank %}
      <section class="wet-team-voices" aria-labelledby="WetVoicesHeading-{{ section.id }}">
        <div class="wet-shell">
          <header class="wet-team-voices__header" data-wet-reveal>
            <div>
              <p class="wet-team-page__eyebrow"><span></span>Voices from the team</p>
              <h2 id="WetVoicesHeading-{{ section.id }}">What our team wants you to know.</h2>
            </div>
            <p>Perspectives from the people who welcome patrons, care for the venue and shape the WET experience.</p>
          </header>

          <div class="wet-team-voices__grid">
            {% for voice in wet_staff_voices %}
              <article class="wet-team-voice{% if voice.photo.value == blank %} wet-team-voice--no-photo{% endif %}" data-wet-reveal>
                {% if voice.photo.value != blank %}
                  <div class="wet-team-voice__photo">
                    {{ voice.photo.value | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', loading: 'lazy', alt: voice.staff_name.value }}
                  </div>
                {% endif %}
                <div class="wet-team-voice__content">
                  <div class="wet-team-voice__meta">
                    <span>{{ voice.topic.value }}</span>
                    {% if voice.published_on.value != blank %}<time datetime="{{ voice.published_on.value }}">{{ voice.published_on.value | date: '%B %Y' }}</time>{% endif %}
                  </div>
                  <h3>{{ voice.title.value }}</h3>
                  <blockquote>{{ voice.body.value | escape | newline_to_br }}</blockquote>
                  <footer>
                    <strong>{{ voice.staff_name.value }}</strong>
                    {% if voice.role.value != blank %}<span>{{ voice.role.value }}</span>{% endif %}
                  </footer>
                </div>
              </article>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    <section class="wet-team-visit" aria-labelledby="WetVisitHeading-{{ section.id }}">
      <div class="wet-team-visit__texture" aria-hidden="true"></div>
      <div class="wet-shell wet-team-visit__inner" data-wet-reveal>
        <img src="https://wet.com.au/cdn/shop/files/Logo_Transparent_Background_Socials.png?v=1696580697&amp;width=520" width="180" height="94" loading="lazy" alt="WET Spa and Sauna">
        <h2 id="WetVisitHeading-{{ section.id }}">Plan your visit</h2>
        <p>Come as you are. <span>•</span> Respect others. <span>•</span> Enjoy your time.</p>
        <a class="wet-button" href="/pages/first-timers">Visitor information <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </section>
{% elsif wet_staff_voices != blank %}
  <section class="wet wet-staff-teaser" aria-labelledby="WetStaffHeading-{{ section.id }}">
    <div class="wet-shell">
      <header class="wet-staff-teaser__header" data-wet-reveal>
        <div>
          <p class="wet-kicker">From the WET team</p>
          <h2 id="WetStaffHeading-{{ section.id }}" class="wet-title">The people who shape the atmosphere.</h2>
        </div>
        <p class="wet-lead">Perspectives from the team who welcome patrons, care for the venue and help make every visit feel like WET.</p>
      </header>

      <div class="wet-staff-teaser__grid">
        {% for voice in wet_staff_voices %}
          {% if voice.featured.value %}
            <article class="wet-team-voice{% if voice.photo.value == blank %} wet-team-voice--no-photo{% endif %}" data-wet-reveal>
              {% if voice.photo.value != blank %}
                <div class="wet-team-voice__photo">
                  {{ voice.photo.value | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', loading: 'lazy', alt: voice.staff_name.value }}
                </div>
              {% endif %}
              <div class="wet-team-voice__content">
                <div class="wet-team-voice__meta"><span>{{ voice.topic.value }}</span></div>
                <h3>{{ voice.title.value }}</h3>
                <blockquote>{{ voice.body.value | escape | newline_to_br }}</blockquote>
                <footer><strong>{{ voice.staff_name.value }}</strong>{% if voice.role.value != blank %}<span>{{ voice.role.value }}</span>{% endif %}</footer>
              </div>
            </article>
            {% assign wet_staff_shown = wet_staff_shown | plus: 1 %}
            {% if wet_staff_shown >= wet_staff_limit %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.show_archive_link %}
        <div class="wet-staff-teaser__actions"><a class="wet-button wet-button--outline" href="/pages/from-the-team">Meet the WET team</a></div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
.wet-team-page{overflow:hidden;background:var(--wet-black);color:var(--wet-white)}
.wet-team-page__hero{position:relative;padding:clamp(165px,18vw,250px) 0 clamp(80px,10vw,138px);border-bottom:1px solid var(--wet-line);background:radial-gradient(circle at 83% 35%,rgba(215,17,42,.055),transparent 32%),var(--wet-black)}
.wet-team-page__hero-grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(380px,.92fr);gap:clamp(44px,7vw,110px);align-items:center}
.wet-team-page__intro{position:relative;z-index:2}.wet-team-page__eyebrow{display:flex;align-items:center;gap:14px;margin:0 0 22px;color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.wet-team-page__eyebrow span{display:block;width:38px;height:5px;background:var(--wet-red)}
.wet-team-page__intro h1{max-width:800px;margin:0;font-family:var(--wet-display);font-size:clamp(70px,8.2vw,132px);font-weight:900;letter-spacing:-.055em;line-height:.77;text-transform:uppercase}.wet-team-page__intro h1 span{color:var(--wet-red)}
.wet-team-page__promise{margin:30px 0 26px;color:var(--wet-red);font-size:clamp(18px,1.55vw,24px);line-height:1.35}.wet-team-page__copy{max-width:700px;color:rgba(246,243,238,.86);font-size:clamp(16px,1.25vw,19px);line-height:1.55}.wet-team-page__copy p{margin:0 0 20px}
.wet-team-page__hero-art{position:relative;min-height:520px;isolation:isolate}.wet-team-page__brush{position:absolute;z-index:-1;background:linear-gradient(105deg,transparent 2%,#17181a 18%,#101113 75%,transparent 96%);filter:blur(.2px);transform:rotate(-8deg)}.wet-team-page__brush--one{inset:15% -6% 24% 0;clip-path:polygon(2% 35%,19% 22%,14% 7%,35% 18%,47% 0,53% 17%,77% 4%,70% 24%,100% 19%,83% 48%,98% 67%,73% 66%,82% 91%,54% 76%,38% 100%,32% 77%,7% 89%,18% 60%,0 53%)}.wet-team-page__brush--two{inset:29% 7% 9% -10%;opacity:.55;transform:rotate(9deg)}.wet-team-page__people-mark{position:absolute;top:20%;left:15%;width:70%;height:auto;color:var(--wet-red)}.wet-team-page__sweep{position:absolute;right:-2%;bottom:6%;width:90%;height:120px;color:var(--wet-red);transform:rotate(-5deg)}
.wet-team-beliefs{padding:clamp(80px,10vw,140px) 0 clamp(70px,9vw,120px)}.wet-team-page__section-heading{display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center;margin-bottom:48px}.wet-team-page__section-heading h2{margin:0;font-family:var(--wet-display);font-size:clamp(25px,2.3vw,35px);font-weight:900;letter-spacing:.01em;text-transform:uppercase}.wet-team-page__section-heading span{height:1px;background:var(--wet-line)}
.wet-team-beliefs__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.wet-team-belief{position:relative;padding:0 clamp(24px,3vw,46px);text-align:center}.wet-team-belief:first-child{padding-left:0}.wet-team-belief:last-child{padding-right:0}.wet-team-belief+.wet-team-belief{border-left:1px solid var(--wet-line)}.wet-team-belief__icon{display:grid;width:86px;height:86px;margin:0 auto 30px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);box-shadow:inset 0 0 0 1px rgba(255,255,255,.025)}.wet-team-belief__icon svg{width:52px;height:52px;fill:none;stroke:var(--wet-red);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}.wet-team-belief h3{margin:0 0 14px;font-family:var(--wet-display);font-size:18px;font-weight:900;line-height:1.15;text-transform:uppercase}.wet-team-belief p{max-width:250px;margin:0 auto;color:rgba(246,243,238,.82);font-size:15px;line-height:1.55}
.wet-team-respect{display:grid;grid-template-columns:minmax(240px,.34fr) minmax(0,.66fr);margin-bottom:clamp(65px,8vw,110px);border:1px solid rgba(196,199,204,.32);border-radius:14px;background:linear-gradient(125deg,rgba(255,255,255,.035),transparent 48%),#0a0a0b;overflow:hidden}.wet-team-respect__art{display:grid;min-height:320px;place-items:center;border-right:1px solid rgba(215,17,42,.42);background:radial-gradient(circle,rgba(215,17,42,.08),transparent 63%)}.wet-team-respect__art svg{width:min(74%,240px);fill:none;stroke:var(--wet-white);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}.wet-team-respect__art .wet-team-respect__accent{stroke:var(--wet-red)}.wet-team-respect__content{padding:clamp(42px,5vw,78px)}.wet-team-respect__content h2,.wet-team-commitment__copy h2{position:relative;margin:0 0 34px;font-family:var(--wet-display);font-size:clamp(31px,3vw,47px);font-weight:900;letter-spacing:-.025em;line-height:.9;text-transform:uppercase}.wet-team-respect__content h2:after,.wet-team-commitment__copy h2:after{content:"";position:absolute;left:0;bottom:-17px;width:43px;height:3px;background:var(--wet-red)}.wet-team-respect__content p{max-width:830px;margin:0 0 15px;color:rgba(246,243,238,.84);font-size:16px;line-height:1.55}
.wet-team-commitment{display:grid;grid-template-columns:110px minmax(0,1fr) minmax(280px,.46fr);gap:clamp(28px,4vw,62px);align-items:start;padding:0 8px clamp(80px,10vw,140px)}.wet-team-commitment__badge svg{width:90px;height:90px;fill:none;stroke:var(--wet-white);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.wet-team-commitment__copy p{max-width:620px;margin:0 0 16px;color:rgba(246,243,238,.82);font-size:16px;line-height:1.55}.wet-team-commitment__copy strong{display:block;color:var(--wet-red);font-size:18px}.wet-team-commitment__list{display:grid;gap:16px;margin:0;padding:14px 0 14px clamp(30px,4vw,58px);border-left:1px solid var(--wet-line);list-style:none}.wet-team-commitment__list li{position:relative;padding-left:29px;color:rgba(246,243,238,.9);font-size:16px}.wet-team-commitment__list li:before{content:"✓";position:absolute;left:0;color:var(--wet-red);font-weight:900}
.wet-team-voices{padding:clamp(80px,10vw,145px) 0;background:var(--wet-panel);border-top:1px solid var(--wet-line)}.wet-team-voices__header,.wet-staff-teaser__header{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:clamp(40px,8vw,120px);align-items:end;margin-bottom:clamp(48px,7vw,90px)}.wet-team-voices__header h2{max-width:880px;margin:0;font-family:var(--wet-display);font-size:clamp(52px,7vw,104px);font-weight:900;letter-spacing:-.05em;line-height:.82;text-transform:uppercase}.wet-team-voices__header>p{max-width:460px;margin:0;color:var(--wet-muted);font-size:16px;line-height:1.6}
.wet-team-voices__grid,.wet-staff-teaser__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.wet-team-voice{display:grid;grid-template-columns:minmax(0,.4fr) minmax(0,.6fr);min-height:480px;border:1px solid var(--wet-line);background:linear-gradient(135deg,rgba(215,17,42,.08),transparent 42%),var(--wet-black)}.wet-team-voice:only-child{grid-column:1/-1;grid-template-columns:minmax(300px,.34fr) minmax(0,.66fr)}.wet-team-voice.wet-team-voice--no-photo{grid-template-columns:1fr;min-height:auto}.wet-team-voice--no-photo .wet-team-voice__content{max-width:1020px}.wet-team-voice--no-photo blockquote{max-width:900px}.wet-team-voice__photo{min-height:100%;overflow:hidden;background:#111}.wet-team-voice__photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.7) contrast(1.08)}.wet-team-voice__content{display:grid;align-content:start;padding:clamp(32px,4vw,60px)}.wet-team-voice__meta{display:flex;justify-content:space-between;gap:18px;margin-bottom:clamp(34px,4vw,54px);color:var(--wet-silver);font-size:9px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.wet-team-voice h3{margin:0;font-family:var(--wet-display);font-size:clamp(36px,4.2vw,62px);font-weight:900;letter-spacing:-.04em;line-height:.88;text-transform:uppercase}.wet-team-voice blockquote{margin:28px 0 0;color:rgba(246,243,238,.86);font-family:var(--wet-serif);font-size:clamp(19px,1.7vw,25px);line-height:1.45}.wet-team-voice footer{display:grid;gap:5px;margin-top:38px;padding-top:18px;border-top:1px solid var(--wet-line)}.wet-team-voice footer strong{font-size:11px;letter-spacing:.12em;text-transform:uppercase}.wet-team-voice footer span{color:var(--wet-muted);font-size:12px}
.wet-team-visit{position:relative;overflow:hidden;border-top:1px solid var(--wet-line);background:linear-gradient(100deg,#080808 0%,#170609 52%,#090909 100%)}.wet-team-visit__texture{position:absolute;inset:0;opacity:.38;background:repeating-linear-gradient(100deg,transparent 0 3px,rgba(215,17,42,.08) 4px,transparent 6px),radial-gradient(ellipse at 50% 110%,rgba(215,17,42,.28),transparent 60%)}.wet-team-visit__inner{position:relative;z-index:1;display:grid;justify-items:center;padding:clamp(58px,7vw,92px) 0;text-align:center}.wet-team-visit__inner img{width:128px;height:auto;margin:0 0 22px;object-fit:contain}.wet-team-visit h2{margin:0 0 10px;font-family:var(--wet-display);font-size:clamp(42px,4.5vw,68px);font-weight:900;letter-spacing:-.035em;line-height:.88;text-transform:uppercase}.wet-team-visit p{margin:0 0 28px;color:var(--wet-silver);font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.wet-team-visit p span{margin:0 13px;color:var(--wet-red)}.wet-team-visit .wet-button{min-width:260px}.wet-team-visit .wet-button span{margin-left:17px;font-size:20px}
.wet-staff-teaser{padding:clamp(90px,12vw,180px) 0;background:var(--wet-panel)}.wet-staff-teaser__actions{display:flex;justify-content:flex-end;margin-top:34px}
@media(max-width:980px){.wet-team-page__hero-grid{grid-template-columns:1fr}.wet-team-page__hero-art{min-height:430px}.wet-team-page__people-mark{left:20%;width:60%}.wet-team-beliefs__grid{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:54px}.wet-team-belief:nth-child(3){border-left:0}.wet-team-respect{grid-template-columns:1fr}.wet-team-respect__art{min-height:260px;border-right:0;border-bottom:1px solid rgba(215,17,42,.42)}.wet-team-commitment{grid-template-columns:90px 1fr}.wet-team-commitment__list{grid-column:2}.wet-team-voices__header,.wet-staff-teaser__header{grid-template-columns:1fr}.wet-team-voice,.wet-team-voice:only-child{grid-template-columns:1fr}.wet-team-voice__photo{min-height:400px}}
@media(max-width:760px){.wet-team-page__hero{padding-top:145px}.wet-team-page__hero-grid{gap:28px}.wet-team-page__intro h1{font-size:clamp(58px,18vw,82px)}.wet-team-page__promise{margin-top:24px}.wet-team-page__hero-art{min-height:300px}.wet-team-page__people-mark{top:5%;left:14%;width:72%}.wet-team-page__sweep{bottom:0;width:100%}.wet-team-beliefs__grid{grid-template-columns:1fr}.wet-team-belief,.wet-team-belief:first-child,.wet-team-belief:last-child{padding:0 0 42px}.wet-team-belief+.wet-team-belief{padding-top:42px;border-top:1px solid var(--wet-line);border-left:0}.wet-team-belief__icon{margin-bottom:23px}.wet-team-belief p{max-width:320px}.wet-team-respect{border-radius:9px}.wet-team-respect__art{min-height:220px}.wet-team-respect__content{padding:36px 25px}.wet-team-commitment{grid-template-columns:1fr;padding-inline:0}.wet-team-commitment__badge svg{width:78px;height:78px}.wet-team-commitment__list{grid-column:1;padding:28px 0 0;border-top:1px solid var(--wet-line);border-left:0}.wet-team-voices__grid,.wet-staff-teaser__grid{grid-template-columns:1fr}.wet-team-voice:only-child{grid-column:auto}.wet-team-voice__photo{min-height:340px}.wet-team-voices__header h2{font-size:52px}.wet-team-visit p{max-width:320px;line-height:1.8}.wet-team-visit p span{margin:0 6px}.wet-staff-teaser__actions{justify-content:stretch}.wet-staff-teaser__actions .wet-button{width:100%}}
@media(prefers-reduced-motion:reduce){.wet-team-page__sweep{transform:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "WET staff voices",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Display mode",
      "options": [
        { "value": "teaser", "label": "Featured entries" },
        { "value": "archive", "label": "Complete archive" }
      ],
      "default": "teaser"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum featured entries",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_archive_link",
      "label": "Show archive link",
      "default": true
    }
  ],
  "presets": [{ "name": "WET staff voices" }]
}
{% endschema %}
