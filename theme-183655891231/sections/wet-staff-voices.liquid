{% liquid
  assign wet_staff_voices = metaobjects.wet_staff_voice.values
  assign wet_staff_shown = 0
  assign wet_staff_limit = section.settings.max_items | default: 3
%}

{% if wet_staff_voices != blank %}
  <section class="wet wet-staff-voices wet-staff-voices--{{ section.settings.mode }}" aria-labelledby="WetStaffHeading-{{ section.id }}">
    <div class="wet-shell">
      <header class="wet-staff-voices__header">
        <div>
          <p class="wet-kicker">From the WET team</p>
          {% if section.settings.mode == 'archive' %}
            <h1 id="WetStaffHeading-{{ section.id }}" class="wet-display">The people behind WET.</h1>
          {% else %}
            <h2 id="WetStaffHeading-{{ section.id }}" class="wet-title">The people who shape the atmosphere.</h2>
          {% endif %}
        </div>
        <p class="wet-lead">Perspectives from the team who welcome patrons, care for the venue and help make every visit feel like WET.</p>
      </header>

      <div class="wet-staff-voices__grid">
        {% for voice in wet_staff_voices %}
          {% liquid
            assign wet_show_voice = true
            if section.settings.mode != 'archive'
              unless voice.featured.value
                assign wet_show_voice = false
              endunless
            endif
          %}
          {% if wet_show_voice %}
            <article class="wet-staff-voice{% if voice.photo.value == blank %} wet-staff-voice--no-photo{% endif %}">
              {% if voice.photo.value != blank %}
                <div class="wet-staff-voice__photo">
                  {{ voice.photo.value | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', loading: 'lazy', alt: voice.staff_name.value }}
                </div>
              {% endif %}
              <div class="wet-staff-voice__content">
                <div class="wet-staff-voice__meta">
                  <span>{{ voice.topic.value }}</span>
                  {% if voice.published_on.value != blank %}<time datetime="{{ voice.published_on.value }}">{{ voice.published_on.value | date: '%B %Y' }}</time>{% endif %}
                </div>
                <h3>{{ voice.title.value }}</h3>
                <blockquote>{{ voice.body.value | escape | newline_to_br }}</blockquote>
                <footer>
                  <strong>{{ voice.staff_name.value }}</strong>
                  {% if voice.role.value != blank %}<span>{{ voice.role.value }}</span>{% endif %}
                </footer>
              </div>
            </article>
            {% assign wet_staff_shown = wet_staff_shown | plus: 1 %}
            {% if section.settings.mode != 'archive' and wet_staff_shown >= wet_staff_limit %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.mode != 'archive' and section.settings.show_archive_link %}
        <div class="wet-staff-voices__actions"><a class="wet-button wet-button--outline" href="/pages/from-the-team">Read more from the team</a></div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
.wet-staff-voices{padding:clamp(90px,12vw,180px) 0;background:var(--wet-panel)}.wet-staff-voices--archive{padding-top:clamp(180px,19vw,280px);background:var(--wet-black)}.wet-staff-voices__header{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.75fr);gap:clamp(42px,9vw,130px);align-items:end;margin-bottom:clamp(50px,8vw,100px)}.wet-staff-voices--archive .wet-staff-voices__header{align-items:center}.wet-staff-voices--archive .wet-display{max-width:900px;font-size:clamp(86px,12vw,190px);line-height:.72}.wet-staff-voices__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.wet-staff-voice{display:grid;grid-template-columns:minmax(0,.42fr) minmax(0,.58fr);min-height:530px;border:1px solid var(--wet-line);background:var(--wet-black)}.wet-staff-voice:only-child{grid-column:1/-1;grid-template-columns:minmax(300px,.36fr) minmax(0,.64fr)}.wet-staff-voice.wet-staff-voice--no-photo{grid-template-columns:1fr;background:linear-gradient(135deg,rgba(215,17,42,.13),transparent 44%),var(--wet-black)}.wet-staff-voice__photo{min-height:100%;overflow:hidden;background:#111}.wet-staff-voice__photo img{width:100%;height:100%;object-fit:cover;filter:saturate(.72) contrast(1.08)}.wet-staff-voice__content{display:grid;align-content:start;padding:clamp(34px,5vw,72px)}.wet-staff-voice__meta{display:flex;justify-content:space-between;gap:20px;margin-bottom:clamp(45px,6vw,80px);color:var(--wet-silver);font-size:9px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.wet-staff-voice h3{max-width:760px;font-family:var(--wet-display);font-size:clamp(43px,5vw,76px);font-weight:900;letter-spacing:-.045em;line-height:.84;text-transform:uppercase}.wet-staff-voice blockquote{max-width:800px;margin:clamp(30px,4vw,50px) 0 0;color:rgba(255,255,255,.86);font-family:var(--wet-serif);font-size:clamp(21px,2vw,30px);line-height:1.45}.wet-staff-voice footer{display:grid;gap:5px;margin-top:clamp(38px,5vw,65px);padding-top:20px;border-top:1px solid var(--wet-line)}.wet-staff-voice footer strong{font-size:11px;letter-spacing:.12em;text-transform:uppercase}.wet-staff-voice footer span{color:var(--wet-muted);font-size:12px}.wet-staff-voices__actions{display:flex;justify-content:flex-end;margin-top:34px}
@media(max-width:980px){.wet-staff-voices__header{grid-template-columns:1fr}.wet-staff-voice,.wet-staff-voice:only-child{grid-template-columns:1fr}.wet-staff-voice__photo{min-height:420px}}
@media(max-width:760px){.wet-staff-voices__grid{grid-template-columns:1fr}.wet-staff-voice:only-child{grid-column:auto}.wet-staff-voice__photo{min-height:360px}.wet-staff-voice__meta{margin-bottom:38px}.wet-staff-voice h3{font-size:48px}.wet-staff-voice blockquote{font-size:21px}.wet-staff-voices__actions{justify-content:stretch}.wet-staff-voices__actions .wet-button{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "WET staff voices",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Display mode",
      "options": [
        { "value": "teaser", "label": "Featured entries" },
        { "value": "archive", "label": "Complete archive" }
      ],
      "default": "teaser"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum featured entries",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_archive_link",
      "label": "Show archive link",
      "default": true
    }
  ],
  "presets": [{ "name": "WET staff voices" }]
}
{% endschema %}
