@media(max-width:1180px){.wet-header__bar{grid-template-columns:1fr auto}.wet-header__nav,.wet-header__contact{display:none}.wet-header__toggle{display:block}.wet-page-hero__content,.wet-section__head{grid-template-columns:1fr;gap:34px}.wet-page-hero__aside,.wet-section__aside{justify-self:start;max-width:650px}.wet-grid-3{grid-template-columns:1fr 1fr}.wet-footer__main{grid-template-columns:1fr 1fr}.wet-footer__brand{grid-column:1/-1}.wet-stats{grid-template-columns:1fr 1fr}.wet-stat:nth-child(2){border-right:0}.wet-stat:nth-child(-n+2){border-bottom:1px solid var(--wet-line)}}
