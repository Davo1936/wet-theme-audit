<header class="wet-header" data-wet-header>
  <a class="wet-header__event" href="https://www.eventbrite.com.au/e/splash-swimwear-dance-party-tickets-1994492753516" target="_blank" rel="noopener">
    <span>SPLASH - Friday 21 August - 7pm to midnight</span>
    <span aria-hidden="true">Tickets ↗</span>
  </a>
  <div class="wet-header__bar">
    <a class="wet-header__logo" href="{{ routes.root_url }}" aria-label="WET Spa and Sauna home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 520 | image_tag: widths: '180, 260, 360, 520', width: 180, loading: 'eager', alt: 'WET Spa and Sauna' }}
      {% else %}
        <img src="https://wet.com.au/cdn/shop/files/Logo_Transparent_Background_Socials.png?v=1696580697&amp;width=520" width="180" height="94" loading="eager" alt="WET Spa and Sauna">
      {% endif %}
    </a>
    <nav class="wet-header__nav" aria-label="Primary navigation">
      <a data-wet-nav href="/pages/pricing-entry">Visit WET</a>
      <a data-wet-nav href="/pages/events">Events</a>
      <a data-wet-nav href="/pages/gallery">Facilities</a>
      <a data-wet-nav href="/pages/first-timers">First visit</a>
      <a data-wet-nav href="/pages/food-drink">Food &amp; drink</a>
      <a data-wet-nav href="/pages/from-the-team">From the team</a>
      <a data-wet-nav href="/pages/sexual-health-clinic">Health &amp; safety</a>
    </nav>
    <a class="wet-header__contact" href="/pages/contact">Find WET</a>
    <button class="wet-header__toggle" type="button" aria-expanded="false" aria-controls="WetMenu" aria-label="Open menu" data-wet-menu-toggle>
      <span></span><span></span>
    </button>
  </div>
  <div class="wet-menu" id="WetMenu" aria-hidden="true" data-wet-menu>
    <div class="wet-menu__main">
      <p class="wet-menu__kicker">Explore WET</p>
      <nav aria-label="Mobile navigation">
        <a data-wet-nav href="/pages/pricing-entry"><span class="wet-menu__icon">{% render 'wet-icon', name: 'compass' %}</span>Visit WET</a>
        <a data-wet-nav href="/pages/events"><span class="wet-menu__icon">{% render 'wet-icon', name: 'calendar' %}</span>Events</a>
        <a data-wet-nav href="/pages/gallery"><span class="wet-menu__icon">{% render 'wet-icon', name: 'pool' %}</span>Facilities</a>
        <a data-wet-nav href="/pages/first-timers"><span class="wet-menu__icon">{% render 'wet-icon', name: 'id' %}</span>First visit</a>
        <a data-wet-nav href="/pages/food-drink"><span class="wet-menu__icon">{% render 'wet-icon', name: 'food' %}</span>Food &amp; drink</a>
        <a data-wet-nav href="/pages/from-the-team"><span class="wet-menu__icon">{% render 'wet-icon', name: 'team' %}</span>From the team</a>
        <a data-wet-nav href="/pages/sexual-health-clinic"><span class="wet-menu__icon">{% render 'wet-icon', name: 'health' %}</span>Health &amp; safety</a>
        <a data-wet-nav href="/pages/faq"><span class="wet-menu__icon">{% render 'wet-icon', name: 'faq' %}</span>FAQ</a>
        <a data-wet-nav href="/pages/contact"><span class="wet-menu__icon">{% render 'wet-icon', name: 'location' %}</span>Contact</a>
      </nav>
    </div>
    <div class="wet-menu__meta">
      <span>Visit WET</span>
      <p>22 Jeays Street, Bowen Hills QLD 4006</p>
      <a href="tel:+61738541383">07 3854 1383</a>
      <p>Adults 18+ - current physical photo ID required</p>
      <a class="wet-menu__direction" href="/pages/contact">Directions &amp; contact</a>
    </div>
  </div>
</header>

{% stylesheet %}
:root{--wet-black:#050506;--wet-charcoal:#0d0e10;--wet-panel:#0a0a0b;--wet-red:#d7112a;--wet-red-dark:#981221;--wet-burgundy:#650d18;--wet-silver:#c4c7cc;--wet-white:#f6f3ee;--wet-muted:#b0adb0;--wet-line:rgba(196,199,204,.22);--wet-max:1480px;--wet-gutter:clamp(20px,4.5vw,76px);--wet-display:"Arial Narrow","Roboto Condensed","Helvetica Neue Condensed",Arial,sans-serif;--wet-body:Inter,"Helvetica Neue",Arial,sans-serif;--wet-serif:"Cormorant Garamond",Georgia,serif}
html{background:var(--wet-black);scroll-behavior:smooth}
body,.page-container,.transition-body,.main-content,#MainContent{background:var(--wet-black)!important;color:var(--wet-white)}
body{overflow-x:hidden}
body.wet-menu-open{overflow:hidden}
.wet,.wet-header,.wet-footer{font-family:var(--wet-body);color:var(--wet-white)}
.wet *,.wet-header *,.wet-footer *{box-sizing:border-box}
.wet img,.wet video{display:block;width:100%;max-width:100%}
.wet a,.wet-header a,.wet-footer a{color:inherit;text-decoration:none}
.wet h1,.wet h2,.wet h3,.wet h4,.wet p,.wet figure,.wet blockquote,.wet ul{margin:0}
.wet button,.wet input,.wet textarea,.wet select,.wet-header button{font:inherit}
.wet-shell{width:min(var(--wet-max),calc(100% - var(--wet-gutter)*2));margin-inline:auto}
.wet-shell--narrow{width:min(980px,calc(100% - var(--wet-gutter)*2));margin-inline:auto}
.wet-kicker{display:flex;align-items:center;gap:14px;color:var(--wet-silver);font-size:11px;font-weight:800;letter-spacing:.2em;line-height:1.2;text-transform:uppercase}
.wet-kicker:before{content:"";width:42px;height:2px;background:var(--wet-red)}
.wet-display,.wet-title,.wet-card h3,.wet-event__name,.wet-price__number{font-family:var(--wet-display);font-stretch:condensed;text-transform:uppercase}
.wet-display{font-size:clamp(72px,9.2vw,142px);font-weight:900;letter-spacing:-.055em;line-height:.78;text-wrap:balance}
.wet-title{max-width:15ch;font-size:clamp(48px,5.8vw,88px);font-weight:900;letter-spacing:-.045em;line-height:.86;text-wrap:balance}
.wet-title--small{font-size:clamp(38px,4.4vw,64px)}
.wet-lead{max-width:720px;color:var(--wet-white);font-size:clamp(20px,2.15vw,31px);font-weight:450;letter-spacing:-.025em;line-height:1.38}
.wet-copy{color:var(--wet-muted);font-size:16px;line-height:1.72}
.wet-copy p+p{margin-top:1em}
.wet-button{min-height:54px;display:inline-flex;align-items:center;justify-content:center;padding:0 26px;border:1px solid var(--wet-red);background:var(--wet-red);color:#fff!important;font-size:11px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;transition:background .22s ease,border-color .22s ease,color .22s ease,transform .22s ease}
.wet-button:hover{background:#f01836;border-color:#f01836;transform:translateY(-2px)}
.wet-button--outline{background:transparent;border-color:var(--wet-line);color:var(--wet-white)!important}
.wet-button--outline:hover{background:var(--wet-white);border-color:var(--wet-white);color:var(--wet-black)!important}
.wet-actions{display:flex;flex-wrap:wrap;gap:12px}
.wet-link{display:inline-flex;align-items:center;gap:12px;padding-bottom:7px;border-bottom:1px solid var(--wet-line);font-size:11px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
.wet-link:hover{border-color:var(--wet-red);color:#fff}
.wet-section{position:relative;padding-block:clamp(72px,8vw,118px);border-bottom:1px solid var(--wet-line);overflow:hidden}
.wet-section--tight{padding-block:clamp(52px,6vw,84px)}
.wet-section--red{background:var(--wet-red)}
.wet-section--burgundy{background:var(--wet-burgundy)}
.wet-section--panel{background:radial-gradient(circle at 88% 18%,rgba(215,17,42,.045),transparent 28%),var(--wet-charcoal)}
.wet-section__head{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.55fr);gap:clamp(42px,8vw,120px);align-items:end;margin-bottom:clamp(48px,7vw,92px)}
.wet-section__aside{max-width:500px;justify-self:end}
.wet-section__aside .wet-actions{margin-top:28px}
.wet-curve{position:absolute;pointer-events:none;border-radius:50%}
.wet-curve--silver{width:120%;height:420px;left:-10%;bottom:-350px;border:2px solid rgba(196,199,204,.42)}
.wet-curve--red{width:120%;height:520px;left:-25%;bottom:-420px;border:90px solid rgba(215,17,42,.18)}
.wet-media{position:relative;overflow:hidden;border:1px solid rgba(196,199,204,.24);border-radius:12px;background:var(--wet-panel)}
.wet-media img,.wet-media video{height:100%;object-fit:cover;filter:saturate(.82) contrast(1.08);transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .3s ease}
.wet-media:hover img{transform:scale(1.025);filter:saturate(1) contrast(1.08)}
.wet-media__label{position:absolute;inset:auto 18px 18px;display:flex;justify-content:space-between;gap:24px;padding:13px 15px;border-left:3px solid var(--wet-red);background:rgba(5,5,6,.86);backdrop-filter:blur(12px);font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
.wet-grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.wet-grid-3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.wet-card{position:relative;min-width:0;padding:clamp(30px,4vw,54px);border:1px solid rgba(196,199,204,.27);border-radius:14px;background:linear-gradient(135deg,rgba(255,255,255,.032),transparent 46%),var(--wet-panel);overflow:hidden;transition:border-color .24s ease,transform .24s ease,background .24s ease}
.wet-card:hover{border-color:rgba(215,17,42,.58);transform:translateY(-3px);background:linear-gradient(135deg,rgba(215,17,42,.065),transparent 48%),var(--wet-panel)}
.wet-card:before{content:"";position:absolute;top:0;left:clamp(30px,4vw,54px);width:42px;height:3px;background:var(--wet-red)}
.wet-card__eyebrow{display:grid;width:68px;height:68px;margin-bottom:32px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);color:var(--wet-red);font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase;box-shadow:inset 0 0 0 1px rgba(255,255,255,.03)}
.wet-card__icon{display:grid;width:76px;height:76px;margin-bottom:32px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#1b1c1f,#0c0d0f);color:var(--wet-red);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}
.wet-card__icon .wet-icon{width:44px;height:44px;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}
.wet-icon{display:block;fill:none;stroke:currentColor;stroke-width:2.25;stroke-linecap:round;stroke-linejoin:round}
.wet-card h3{margin-bottom:18px;font-size:clamp(34px,3.5vw,56px);font-weight:900;letter-spacing:-.035em;line-height:.9}
.wet-card p{color:var(--wet-muted);font-size:15px;line-height:1.65}
.wet-stats{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--wet-line);background:#08090a}
.wet-stat{min-width:0;display:grid;gap:8px;padding:30px var(--wet-gutter);border-right:1px solid var(--wet-line)}
.wet-stat:last-child{border-right:0}
.wet-stat strong{font-family:var(--wet-display);font-size:clamp(28px,3vw,46px);font-weight:900;letter-spacing:-.025em;text-transform:uppercase}
.wet-stat span{color:var(--wet-muted);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.wet-page{padding-top:122px}
.wet-page-hero{position:relative;min-height:640px;display:grid;align-items:end;overflow:hidden;border-bottom:1px solid var(--wet-line);background:var(--wet-charcoal)}
.wet-page-hero__media,.wet-page-hero__veil{position:absolute;inset:0;width:100%;height:100%}
.wet-page-hero__media{object-fit:cover;filter:saturate(.7) contrast(1.12)}
.wet-page-hero__veil{background:linear-gradient(90deg,rgba(4,4,5,.97),rgba(4,4,5,.66) 48%,rgba(4,4,5,.16) 84%),linear-gradient(180deg,rgba(4,4,5,.08),rgba(4,4,5,.88))}
.wet-page-hero__content{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.52fr);gap:60px;align-items:end;padding-block:96px 68px}
.wet-page-hero__aside{max-width:470px;justify-self:end}
.wet-page-hero__aside .wet-actions{margin-top:26px}
.wet-header{position:absolute;z-index:100;top:0;left:0;width:100%;color:#fff}
.wet-header.is-scrolled{position:fixed}
.wet-header.is-scrolled>.wet-header__event,.wet-header.is-scrolled>.wet-header__bar{animation:wet-header-in .28s ease both}
@keyframes wet-header-in{from{transform:translateY(-100%)}to{transform:translateY(0)}}
.wet-header__event{position:relative;z-index:2;min-height:34px;display:flex;align-items:center;justify-content:center;gap:32px;padding:7px var(--wet-gutter);background:var(--wet-red);font-size:9px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
.wet-header__bar{position:relative;z-index:2;min-height:88px;display:grid;grid-template-columns:190px 1fr auto;gap:36px;align-items:center;padding:0 var(--wet-gutter);border-bottom:1px solid rgba(255,255,255,.17);background:rgba(5,5,6,.96);backdrop-filter:blur(18px)}
.wet-header__logo{display:flex;align-items:center;width:154px}
.wet-header__logo img{display:block;width:154px;height:auto}
.wet-header__logo span{font-family:var(--wet-display);font-size:42px;font-weight:900}
.wet-header__nav{display:flex;justify-content:center;gap:clamp(17px,2.1vw,34px)}
.wet-header__nav a{position:relative;padding:34px 0 31px;font-size:10px;font-weight:850;letter-spacing:.11em;text-transform:uppercase}
.wet-header__nav a:after{content:"";position:absolute;left:0;right:100%;bottom:22px;height:2px;background:var(--wet-red);transition:right .22s ease}
.wet-header__nav a:hover:after,.wet-header__nav a[aria-current="page"]:after{right:0}
.wet-header__contact{min-height:44px;display:flex;align-items:center;padding:0 20px;border:1px solid var(--wet-line);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase}
.wet-header__contact:hover{background:var(--wet-red);border-color:var(--wet-red)}
.wet-header__toggle{display:none;width:48px;height:48px;border:0;background:transparent;color:#fff;cursor:pointer}
.wet-header__toggle span{display:block;width:26px;height:2px;margin:7px auto;background:currentColor;transition:transform .25s ease}
.wet-header__toggle[aria-expanded="true"] span:first-child{transform:translateY(4.5px) rotate(45deg)}
.wet-header__toggle[aria-expanded="true"] span:last-child{transform:translateY(-4.5px) rotate(-45deg)}
.wet-menu{position:fixed;z-index:-1;inset:0;width:100%;height:100dvh;min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) minmax(270px,360px);gap:clamp(44px,7vw,110px);align-items:center;padding:clamp(146px,16vh,190px) var(--wet-gutter) 52px;background:radial-gradient(circle at 82% 64%,rgba(215,17,42,.09),transparent 29%),linear-gradient(118deg,#050506 0 67%,#09090a 67%);overflow-y:auto;overscroll-behavior:contain;opacity:0;visibility:hidden;transform:translateY(-16px);transition:opacity .24s ease,visibility .24s ease,transform .24s ease}
.wet-menu.is-open{z-index:1;opacity:1;visibility:visible;transform:none}
.wet-menu__main{min-width:0;align-self:center}.wet-menu__kicker{display:flex;align-items:center;gap:13px;margin:0 0 22px;color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.19em;text-transform:uppercase}.wet-menu__kicker:before{content:"";width:38px;height:3px;background:var(--wet-red)}
.wet-menu nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:clamp(34px,5vw,76px);align-content:center;border-top:1px solid var(--wet-line)}
.wet-menu nav a{display:grid;grid-template-columns:42px minmax(0,1fr);gap:16px;align-items:center;min-width:0;padding:15px 0;border-bottom:1px solid var(--wet-line);font-family:var(--wet-display);font-size:clamp(32px,3.15vw,50px);font-weight:900;letter-spacing:-.025em;line-height:.92;text-transform:uppercase;transition:color .2s ease,padding .2s ease}
.wet-menu__icon{display:grid;width:38px;height:38px;place-items:center;border-radius:50%;background:linear-gradient(145deg,#17181b,#090a0b);color:var(--wet-red);box-shadow:inset 0 0 0 1px rgba(255,255,255,.04)}.wet-menu__icon .wet-icon{width:22px;height:22px}
.wet-menu nav a:hover,.wet-menu nav a:focus-visible{padding-left:9px;color:#fff}.wet-menu nav a[aria-current="page"]{color:#fff}.wet-menu nav a[aria-current="page"]:after{content:"";width:7px;height:7px;margin-left:auto;border-radius:50%;background:var(--wet-red)}
.wet-menu__meta{display:grid;align-content:start;gap:16px;padding:34px;border:1px solid var(--wet-line);border-radius:12px;background:rgba(5,5,6,.72);color:var(--wet-muted);font-size:13px;line-height:1.5}.wet-menu__meta>span{margin-bottom:12px;padding-bottom:16px;border-bottom:1px solid var(--wet-line);color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}.wet-menu__meta>a:not(.wet-menu__direction){color:var(--wet-white);font-family:var(--wet-display);font-size:30px;font-weight:900;letter-spacing:-.02em}.wet-menu__direction{min-height:50px;display:flex;align-items:center;justify-content:center;margin-top:12px;border:1px solid var(--wet-red);background:var(--wet-red);color:#fff!important;font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}
.wet-footer{position:relative;border-top:1px solid var(--wet-line);background:#030304;overflow:hidden}
.wet-footer__signup{display:grid;grid-template-columns:minmax(0,.85fr) minmax(320px,1.15fr);gap:80px;align-items:end;padding-block:clamp(68px,9vw,120px);border-bottom:1px solid var(--wet-line)}
.wet-footer__signup h2{margin-top:22px;font-family:var(--wet-display);font-size:clamp(48px,6.5vw,92px);font-weight:900;letter-spacing:-.04em;line-height:.85;text-transform:uppercase}
.wet-footer__signup p{max-width:500px;margin-top:20px;color:var(--wet-muted);font-size:14px;line-height:1.6}
.wet-newsletter__row{display:grid;grid-template-columns:1fr auto;border-bottom:2px solid var(--wet-silver)}
.wet-newsletter input{min-width:0;min-height:68px;padding:0;border:0!important;background:transparent!important;color:#fff!important;box-shadow:none!important;font-size:20px}
.wet-newsletter input::placeholder{color:#777}
.wet-newsletter button{min-height:68px;padding:0 20px;border:0;background:transparent;color:#fff;font-size:11px;font-weight:900;letter-spacing:.15em;text-transform:uppercase;cursor:pointer}
.wet-newsletter button:hover{color:#ff4960}
.wet-newsletter__status{margin-top:12px!important;color:var(--wet-white)!important}
.wet-footer__main{display:grid;grid-template-columns:minmax(0,1fr) repeat(2,minmax(180px,.35fr));gap:70px;padding-block:clamp(70px,9vw,120px)}
.wet-footer__brand{display:grid;align-content:start;gap:28px}
.wet-footer__brand img{width:220px;height:auto}
.wet-footer__brand p{max-width:460px;color:var(--wet-muted);font-size:14px;line-height:1.65}
.wet-footer__column{display:grid;align-content:start;gap:13px}
.wet-footer__column h3{margin-bottom:10px;color:var(--wet-silver);font-size:10px;font-weight:900;letter-spacing:.17em;text-transform:uppercase}
.wet-footer__column a,.wet-footer__column p{color:#dad7d3;font-size:13px;line-height:1.6}
.wet-footer__column a:hover{color:#ff4058}
.wet-footer__bottom{display:flex;justify-content:space-between;gap:24px;padding-block:22px;border-top:1px solid var(--wet-line);color:#858185;font-size:9px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
.wet-sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
age-verification-popup{background:var(--wet-black)!important;color:var(--wet-white)!important}
age-verification-popup .modal__inner{background:radial-gradient(circle at 82% 18%,rgba(215,17,42,.17),transparent 34%),repeating-linear-gradient(102deg,transparent 0 4px,rgba(215,17,42,.025) 5px,transparent 8px),var(--wet-black)!important}
age-verification-popup .modal__centered-content{position:relative;max-width:650px!important;padding:clamp(38px,5vw,70px)!important;border:1px solid rgba(196,199,204,.32)!important;border-radius:14px!important;background:linear-gradient(135deg,rgba(255,255,255,.035),transparent 48%),rgba(8,8,10,.98)!important;box-shadow:0 32px 100px rgba(0,0,0,.55)!important}
age-verification-popup .modal__centered-content:before{content:"WET SPA & SAUNA · 18+";display:block;width:max-content;margin:0 auto 23px;padding-top:12px;border-top:3px solid var(--wet-red);color:var(--wet-silver);font-family:var(--wet-body);font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase}
age-verification-popup h2{margin:0!important;color:var(--wet-white)!important;font-family:var(--wet-display)!important;font-size:clamp(50px,7vw,82px)!important;font-weight:900!important;letter-spacing:-.045em!important;line-height:.84!important;text-transform:uppercase!important}
age-verification-popup .enlarge-text,age-verification-popup .enlarge-text p{max-width:510px!important;margin:22px auto 0!important;color:rgba(246,243,238,.82)!important;font-size:16px!important;line-height:1.55!important}
