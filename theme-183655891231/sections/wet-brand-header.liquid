@media(max-width:800px){:root{--wet-gutter:22px}.wet-header__event{justify-content:space-between;gap:10px;font-size:8px}.wet-header__bar{min-height:72px}.wet-header__logo,.wet-header__logo img{width:116px}.wet-page{padding-top:106px}.wet-menu{grid-template-columns:1fr;padding-top:126px}.wet-menu__meta{display:none}.wet-grid-2,.wet-grid-3{grid-template-columns:1fr}.wet-footer__main{grid-template-columns:1fr;gap:44px}.wet-footer__brand{grid-column:auto}.wet-newsletter__row{grid-template-columns:1fr}.wet-newsletter button{justify-self:start;padding:0}.wet-page-hero{min-height:590px}.wet-page-hero__veil{background:linear-gradient(180deg,rgba(4,4,5,.15),rgba(4,4,5,.92) 70%,var(--wet-black))}.wet-page-hero__content{padding-block:82px 48px}.wet-display{font-size:clamp(62px,18vw,90px)}.wet-title{font-size:clamp(43px,12.5vw,62px)}.wet-section{padding-block:68px}.wet-button{width:100%}.wet-card__eyebrow,.wet-card__icon{margin-bottom:26px}age-verification-popup .modal__centered-content{padding:34px 24px!important}age-verification-popup h2{font-size:50px!important}}
@media(max-width:680px){.wet-menu__kicker{margin-bottom:14px}.wet-menu nav{grid-template-columns:1fr}.wet-menu nav a{grid-template-columns:35px minmax(0,1fr);gap:12px;padding:9px 0;font-size:clamp(29px,8.5vw,36px)}.wet-menu__icon{width:32px;height:32px}.wet-menu__icon .wet-icon{width:19px;height:19px}}
