@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.wet *,.wet-header *{animation:none!important;transition:none!important}[data-wet-reveal]{opacity:1;transform:none}}
{% endstylesheet %}

{% javascript %}
(() => {
  const init = () => {
    const header = document.querySelector('[data-wet-header]');
    if (!header || header.dataset.ready === 'true') return;
    header.dataset.ready = 'true';
    const toggle = header.querySelector('[data-wet-menu-toggle]');
    const menu = header.querySelector('[data-wet-menu]');
    const close = () => {
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open menu');
      menu?.setAttribute('aria-hidden', 'true');
      menu?.classList.remove('is-open');
      document.body.classList.remove('wet-menu-open');
    };
    const open = () => {
      toggle?.setAttribute('aria-expanded', 'true');
      toggle?.setAttribute('aria-label', 'Close menu');
      menu?.setAttribute('aria-hidden', 'false');
      menu?.classList.add('is-open');
      document.body.classList.add('wet-menu-open');
    };
    toggle?.addEventListener('click', () => toggle.getAttribute('aria-expanded') === 'true' ? close() : open());
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
    const current = window.location.pathname.replace(/\/$/, '') || '/';
    header.querySelectorAll('[data-wet-nav]').forEach((link) => {
      const target = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/';
      if (target === current) link.setAttribute('aria-current', 'page');
    });
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 140);
    update();
    window.addEventListener('scroll', update, { passive: true });
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('[data-wet-reveal]').forEach((element) => observer.observe(element));
    } else {
      document.querySelectorAll('[data-wet-reveal]').forEach((element) => element.classList.add('is-visible'));
    }
  };
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init, { once: true }) : init();
  document.addEventListener('shopify:section:load', init);
})();
{% endjavascript %}

